 # 주 스레드에서 매 프레임 부른다. 끝났으면 결과를 만들고 true.
 func poll() -> bool:
 	if outcome:
 		return true
 	if _thread == null or _thread.is_alive():
 		return false
-	_thread.wait_to_finish()
+	var facts: Variant = _thread.wait_to_finish()
 	_thread = null
