diff --git a/core/battle/operation_replay.gd b/core/battle/operation_replay.gd
new file mode 100644
index 0000000000000000000000000000000000000000..8ff7c34bd4a9697af49b14e29d0f925cb884d11a
--- /dev/null
+++ b/core/battle/operation_replay.gd
@@ -0,0 +1,142 @@
+extends RefCounted
+
+const Adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+const FORMAT := "p02/restricted-fresh-replay/1"
+const MAX_BYTES := 16 * 1024 * 1024
+const MAX_TICKS := 18000
+const MAX_COMMANDS := 18000
+const MAX_ID := 2147483647
+const ENVELOPE_FIELDS := ["format", "input", "commands"]
+const COMMAND_FIELDS := ["tick", "side", "ids", "kind", "target_id", "point", "args"]
+
+static func _has_exact_fields(value: Variant, fields: Array) -> bool:
+	if not value is Dictionary or value.size() != fields.size():
+		return false
+	for field in fields:
+		if not value.has(field):
+			return false
+	return true
+
+static func _number(value: Variant) -> bool:
+	return typeof(value) in [TYPE_INT, TYPE_FLOAT] and is_finite(float(value))
+
+static func _integer(value: Variant) -> bool:
+	return _number(value) and floor(float(value)) == value
+
+static func _int_in_range(value: Variant, minimum: int, maximum: int) -> bool:
+	return _integer(value) and value >= minimum and value <= maximum
+
+static func _invalid_command(path: String) -> Dictionary:
+	return Adapter.fail("invalid_replay_command", path)
+
+static func _command(raw: Variant, path: String, max_ticks: int, previous_tick: int) -> Dictionary:
+	if not _has_exact_fields(raw, COMMAND_FIELDS):
+		return _invalid_command(path)
+	if not _integer(raw.tick):
+		return _invalid_command(path + ".tick")
+	if raw.tick < 0 or raw.tick >= max_ticks:
+		return Adapter.fail("replay_command_tick", path + ".tick")
+	var tick := int(raw.tick)
+	if tick < previous_tick:
+		return Adapter.fail("replay_command_order", path + ".tick")
+	if not _int_in_range(raw.side, 0, 1):
+		return _invalid_command(path + ".side")
+	if not raw.ids is Array or raw.ids.is_empty():
+		return _invalid_command(path + ".ids")
+	var ids: Array = []
+	var seen := {}
+	for i in raw.ids.size():
+		if not _int_in_range(raw.ids[i], 0, MAX_ID):
+			return _invalid_command("%s.ids[%d]" % [path, i])
+		var id := int(raw.ids[i])
+		if seen.has(id):
+			return _invalid_command("%s.ids[%d]" % [path, i])
+		seen[id] = true
+		ids.append(id)
+	if not raw.kind is String:
+		return _invalid_command(path + ".kind")
+	if raw.kind not in ["move", "stop", "attack"]:
+		return Adapter.fail("unsupported_replay_command", path + ".kind")
+	if not _int_in_range(raw.target_id, -1, MAX_ID):
+		return _invalid_command(path + ".target_id")
+	if not raw.point is Array or raw.point.size() != 2 or not _number(raw.point[0]) or not _number(raw.point[1]):
+		return _invalid_command(path + ".point")
+	var point := Vector2(raw.point[0], raw.point[1])
+	if not point.is_finite():
+		return _invalid_command(path + ".point")
+	if not raw.args is Dictionary or not raw.args.is_empty():
+		return _invalid_command(path + ".args")
+	return {"ok": true, "value": {"tick": tick, "side": int(raw.side), "ids": ids,
+		"kind": raw.kind, "target_id": int(raw.target_id), "point": point, "args": {}}}
+
+static func run(bundle: Variant, replay_file_sha256: String) -> Dictionary:
+	if not _has_exact_fields(bundle, ENVELOPE_FIELDS):
+		return Adapter.fail("invalid_replay_envelope", "$")
+	if not bundle.format is String or bundle.format != FORMAT:
+		return Adapter.fail("unsupported_replay_format", "format")
+	var created := Adapter.create(bundle.input)
+	if not created.ok:
+		var path: String = created.path
+		return Adapter.fail(created.error, "input" if path == "$" else "input." + path)
+	var result := _play_and_close(created, bundle.commands)
+	if not result.ok:
+		return result
+	result["meta"] = created.meta
+	result.meta["executor"] = "replay"
+	result.meta["replay_format"] = FORMAT
+	result.meta["replay_file_sha256"] = replay_file_sha256
+	result.meta["commands_consumed"] = result.commands_consumed
+	result.erase("commands_consumed")
+	return result
+
+static func _play_and_close(created: Dictionary, raw_commands: Variant) -> Dictionary:
+	var owner: OperationPrivateState = created.owner
+	var result := _play(owner, created.policy, created.max_ticks, raw_commands)
+	owner.close()
+	return result
+
+static func _play(owner: OperationPrivateState, policy: String, max_ticks: int, raw_commands: Variant) -> Dictionary:
+	if policy != "none":
+		return Adapter.fail("unsupported_replay_policy", "input.policy")
+	if max_ticks > MAX_TICKS:
+		return Adapter.fail("replay_tick_limit", "input.max_ticks")
+	if not raw_commands is Array:
+		return _invalid_command("commands")
+	if raw_commands.size() > MAX_COMMANDS:
+		return Adapter.fail("replay_command_limit", "commands")
+	var commands: Array = []
+	var previous_tick := -1
+	for i in raw_commands.size():
+		var parsed := _command(raw_commands[i], "commands[%d]" % i, max_ticks, previous_tick)
+		if not parsed.ok:
+			return parsed
+		commands.append(parsed.value)
+		previous_tick = parsed.value.tick
+
+	var events: Array = []
+	var consumed := 0
+	var read := owner.summary()
+	if not read.ok:
+		return read
+	while not read.summary.over and read.summary.tick < max_ticks:
+		var next := consumed
+		while next < commands.size() and commands[next].tick == read.summary.tick:
+			var queued := owner.queue(commands[next])
+			if not queued.ok:
+				return Adapter.fail(queued.error, "commands[%d]" % next)
+			next += 1
+		var advanced := owner.advance()
+		if not advanced.ok:
+			return Adapter.fail(advanced.error, "owner")
+		consumed = next
+		var drained := owner.drain_events()
+		if not drained.ok:
+			return Adapter.fail(drained.error, "owner")
+		events.append_array(drained.events)
+		read = owner.summary()
+		if not read.ok:
+			return read
+	if consumed < commands.size():
+		return Adapter.fail("replay_unconsumed_command", "commands[%d].tick" % consumed)
+	return {"ok": true, "summary": read.summary, "events": events, "event_count": events.size(),
+		"commands_consumed": consumed}
diff --git a/core/battle/operation_runtime_adapter.gd b/core/battle/operation_runtime_adapter.gd
new file mode 100644
index 0000000000000000000000000000000000000000..4b9cb247213fb1e20035c501a46026f8b695f5ce
--- /dev/null
+++ b/core/battle/operation_runtime_adapter.gd
@@ -0,0 +1,80 @@
+extends RefCounted
+
+# Explicit fresh, runtime-ready restricted input. No source-space conversion,
+# module removal, profile fallback, checkpoint, UI or worker ownership.
+const Private := preload("res://core/battle/operation_private_state.gd")
+const FORMAT := "p02/restricted-headless/1"
+const FIELDS := ["mode", "format", "profile", "seed", "hz", "initial_controls", "policy", "max_ticks"]
+const INTEGERS := ["ships", "lv", "p", "command", "might", "intellect", "level", "start_morale_bp"]
+const LIMIT := 2147483647
+
+static func fail(error: String, path: String) -> Dictionary:
+	return {"ok": false, "error": error, "path": path}
+
+static func _integer(value: Variant, minimum: int, maximum: int) -> bool:
+	if typeof(value) not in [TYPE_INT, TYPE_FLOAT]: return false
+	if not is_finite(float(value)) or value < minimum or value > maximum: return false
+	return floor(float(value)) == value
+
+# Pure normalization returns detached values, never an owner or live simulation.
+static func normalize(input: Variant) -> Dictionary:
+	if not input is Dictionary: return fail("invalid_container", "$")
+	if input.has("definition"): return fail("unsupported_input_representation", "definition")
+	if input.has("checkpoint"): return fail("unsupported_checkpoint", "checkpoint")
+	for key in FIELDS:
+		if not input.has(key): return fail("missing_field", key)
+	for key in input:
+		if key not in FIELDS: return fail("unsupported_field", str(key))
+	if typeof(input.mode) != TYPE_STRING or input.mode != "operation": return fail("unsupported_mode", "mode")
+	if typeof(input.format) != TYPE_STRING or input.format != FORMAT: return fail("unsupported_input_representation", "format")
+	if not input.profile is Dictionary: return fail("invalid_container", "profile")
+	var value: Dictionary = input.duplicate(true)
+	for side in ["ally", "foe"]:
+		if not value.profile.has(side): return fail("missing_field", "profile." + side)
+		if not value.profile[side] is Array: return fail("invalid_container", "profile." + side)
+		for i in value.profile[side].size():
+			var path := "profile.%s[%d]" % [side, i]
+			var fleet: Variant = value.profile[side][i]
+			if not fleet is Dictionary: return fail("invalid_container", path)
+			if fleet.has("composition"):
+				if not fleet.composition is Array: return fail("invalid_container", path + ".composition")
+				for j in fleet.composition.size():
+					if not fleet.composition[j] is Dictionary: return fail("invalid_container", path + ".composition[%d]" % j)
+	for key in ["seed", "hz", "max_ticks"]:
+		var minimum := 0 if key == "seed" else 1
+		var maximum := 4294967295 if key == "seed" else LIMIT
+		if not _integer(value[key], minimum, maximum): return fail("invalid_integer", key)
+		value[key] = int(value[key])
+	if value.hz != 10: return fail("unsupported_hz", "hz")
+	for side in ["ally", "foe"]:
+		for i in value.profile[side].size():
+			var path := "profile.%s[%d]" % [side, i]
+			var fleet: Dictionary = value.profile[side][i]
+			for key in INTEGERS:
+				if not fleet.has(key): continue
+				if not _integer(fleet[key], 1 if key in ["ships", "lv"] else 0, LIMIT): return fail("invalid_integer", path + "." + key)
+				fleet[key] = int(fleet[key])
+			var total := 0
+			for j in fleet.get("composition", []).size():
+				var item: Dictionary = fleet.composition[j]
+				if not item.has("count"): return fail("missing_field", path + ".composition[%d].count" % j)
+				if not _integer(item.count, 1, LIMIT): return fail("invalid_integer", path + ".composition[%d].count" % j)
+				item.count = int(item.count)
+				if total > LIMIT - item.count: return fail("integer_total_overflow", path + ".composition")
+				total += item.count
+	if not value.initial_controls is Array: return fail("invalid_container", "initial_controls")
+	if value.initial_controls.size() not in [0, value.profile.ally.size() + value.profile.foe.size()]: return fail("initial_controls", "initial_controls")
+	for i in value.initial_controls.size():
+		if typeof(value.initial_controls[i]) != TYPE_STRING or value.initial_controls[i] not in ["direct", "delegate"]: return fail("initial_controls", "initial_controls[%d]" % i)
+	if typeof(value.policy) != TYPE_STRING or value.policy not in ["none", "attack5"]: return fail("unsupported_policy", "policy")
+	return {"ok": true, "value": value}
+
+static func create(input: Variant) -> Dictionary:
+	var normalized := normalize(input)
+	if not normalized.ok: return normalized
+	var value: Dictionary = normalized.value
+	var created := Private.create(value.profile, value.seed, value.hz, value.initial_controls)
+	if not created.ok:
+		var paths := {"unsupported_reinforcement": "profile.reinf", "unsupported_module_config": "profile.combat", "initial_controls": "initial_controls"}
+		return fail(created.error, paths.get(created.error, "profile"))
+	return {"ok": true, "owner": created.owner, "meta": {"format": FORMAT, "transform": "identity/no-transform", "input_sha256": var_to_bytes(input).hex_encode().sha256_text()}, "policy": value.policy, "max_ticks": value.max_ticks}
diff --git a/core/battle/operation_service_state.gd b/core/battle/operation_service_state.gd
new file mode 100644
index 0000000000000000000000000000000000000000..75cc2a12a90e7f0d62c2ab2ae197aeb434042e71
--- /dev/null
+++ b/core/battle/operation_service_state.gd
@@ -0,0 +1,197 @@
+class_name OperationServiceState
+extends RefCounted
+
+# Partial in-memory component, NOT a checkpoint, save file, C0 or whole ST11.
+# Caller owns a prepared, quiescent target and must first restore every field
+# outside contacts and SUP_FIELDS (ammo/stages/healing/events/commands included).
+# Matching context is necessary, not proof that those external fields agree.
+const FORMAT := "i01b/service-slice/1"
+const SUP_FIELDS := ["sup_src", "sup_prog", "sup_since", "sup_still", "sup_pos", "sup_n", "sup_ammo", "sup_mat", "sup_hold", "sup_first"]
+const RECORD_FIELDS := ["seen", "pos", "state", "conf_bp", "err_r"]
+
+static func capture_partial(sim: BattleSim) -> Dictionary:
+	var error := _bindings(sim)
+	if error != "": return _failure(error)
+	var fleets: Array = []
+	if sim.supply != null:
+		for fleet in sim.st.fleets:
+			var values := {}
+			for field in SUP_FIELDS: values[field] = fleet.get(field)
+			fleets.append({"id": fleet.id, "values": values})
+	var packet := {
+		"format": FORMAT, "context": _context(sim),
+		"detection": {"active": sim.detect != null, "contacts": sim.detect.contacts.duplicate(true) if sim.detect != null else []},
+		"supply": {"active": sim.supply != null, "fleets": fleets},
+	}
+	error = _preflight(sim, packet)
+	if error != "": return _failure(error)
+	return {"ok": true, "packet": packet}
+
+static func restore_into_prepared_target(target: BattleSim, packet: Dictionary) -> Dictionary:
+	var error := _bindings(target)
+	if error == "": error = _preflight(target, packet)
+	if error != "": return _failure(error)
+	# No constructors, evaluation, steps, events or resource spending here.
+	# Validate every late entry before the first write; detach before applying.
+	var detached: Dictionary = packet.duplicate(true)
+	if target.detect != null: target.detect.contacts = detached.detection.contacts
+	if target.supply != null:
+		for i in target.st.fleets.size():
+			for field in SUP_FIELDS:
+				target.st.fleets[i].set(field, detached.supply.fleets[i].values[field])
+	return {"ok": true}
+
+static func _failure(code: String) -> Dictionary:
+	return {"ok": false, "error": code}
+
+static func _keys(value: Variant, expected: Array) -> bool:
+	if not value is Dictionary or value.size() != expected.size(): return false
+	for key in expected:
+		if not value.has(key): return false
+	return true
+
+static func _has(value: Variant, required: Array) -> bool:
+	if not value is Dictionary: return false
+	for key in required:
+		if not value.has(key): return false
+	return true
+
+static func _number(value: Variant) -> bool:
+	return typeof(value) in [TYPE_INT, TYPE_FLOAT]
+
+static func _same(a: Variant, b: Variant) -> bool:
+	if typeof(a) != typeof(b): return false
+	if a is Dictionary:
+		if not _same(a.keys(), b.keys()): return false
+		for key in a:
+			if not _same(a[key], b[key]): return false
+		return true
+	if a is Array:
+		if a.size() != b.size(): return false
+		for i in a.size():
+			if not _same(a[i], b[i]): return false
+		return true
+	return a == b
+
+# Reject objects, non-finite values and cyclic containers before deep copy.
+static func _data(value: Variant, ancestors: Array = []) -> bool:
+	if value is Dictionary or value is Array:
+		for old in ancestors:
+			if is_same(value, old): return false
+		var path := ancestors.duplicate()
+		path.append(value)
+		if value is Dictionary:
+			for key in value:
+				if typeof(key) not in [TYPE_INT, TYPE_STRING, TYPE_STRING_NAME]: return false
+				if not _data(value[key], path): return false
+		else:
+			for entry in value:
+				if not _data(entry, path): return false
+		return true
+	if typeof(value) == TYPE_FLOAT: return is_finite(value)
+	if typeof(value) == TYPE_VECTOR2: return is_finite(value.x) and is_finite(value.y)
+	return typeof(value) in [TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_STRING, TYPE_STRING_NAME]
+
+static func _bindings(sim: BattleSim) -> String:
+	if sim == null or sim.st == null or sim.rs == null: return "invalid_target"
+	if sim.st.hz <= 0: return "invalid_hz"
+	if not _data(sim.R) or not _data(sim.rs.scenario): return "invalid_rules_data"
+	if sim.salvo != null and not _data(sim.salvo.C): return "invalid_combat_data"
+	if sim.detect != null:
+		if sim.salvo == null or not is_same(sim.detect.sim, sim): return "detection_binding"
+		if not is_same(sim.detect.D, sim.salvo.C.get("detection")): return "detection_config_binding"
+		if sim.detect.terr == null: return "terrain_binding"
+		if sim.terrain != null and not is_same(sim.detect.terr, sim.terrain): return "terrain_binding"
+		if sim.terrain == null and not sim.detect.terr.zones.is_empty(): return "terrain_fallback"
+		var cfg: Dictionary = sim.detect.D
+		if not _has(cfg, ["eval_period_s", "confidence_bp"]) or not _number(cfg.eval_period_s) or not _number(cfg.confidence_bp): return "detection_config_fields"
+		if sim.detect._period != maxi(1, BattleRules.ticks(float(cfg.eval_period_s), sim.st.hz)): return "detection_period"
+		if sim.detect._conf0 != int(sim.rs.rt("fog_override.estimated_confidence_basis_points", cfg.confidence_bp)): return "detection_confidence"
+	if sim.supply != null:
+		if sim.salvo == null or not is_same(sim.supply.sim, sim): return "supply_binding"
+		if not is_same(sim.supply.S, sim.salvo.C.get("supply")): return "supply_config_binding"
+		var cfg: Dictionary = sim.supply.S
+		if not _has(cfg, ["ship_type_id", "stationary_s", "repair", "still_eps_px_s", "bases", "mutual"]): return "supply_config_fields"
+		if typeof(cfg.ship_type_id) != TYPE_STRING or not _number(cfg.stationary_s) or not _number(cfg.still_eps_px_s): return "supply_config_type"
+		if not _has(cfg.repair, ["light_recover_s"]) or not _number(cfg.repair.light_recover_s): return "supply_repair_config"
+		if not cfg.bases is Array or not cfg.mutual is Array: return "supply_config_container"
+		for group in cfg.mutual:
+			if not group is Array: return "supply_mutual_config"
+		if sim.supply.ship != str(cfg.ship_type_id): return "supply_ship"
+		if sim.supply.need != BattleRules.ticks(float(cfg.stationary_s), sim.st.hz) * BattleRules.BP: return "supply_need"
+		if sim.supply.light_ticks != BattleRules.ticks(float(cfg.repair.light_recover_s), sim.st.hz): return "supply_light_ticks"
+		if sim.supply.still_eps != float(cfg.still_eps_px_s) / sim.st.hz: return "supply_still_eps"
+		var expected: Array = []
+		for base in cfg.bases:
+			if not _has(base, ["id", "faction_id", "position"]): return "supply_base_config"
+			if not base.position is Array or base.position.size() != 2: return "supply_base_position"
+			if not _number(base.position[0]) or not _number(base.position[1]): return "supply_base_position"
+			var side := -1
+			for fleet in sim.st.fleets:
+				if sim.supply.allied(fleet.faction, str(base.faction_id)): side = fleet.side
+			expected.append({"key": str(base.id), "faction": str(base.faction_id), "side": side, "pos": Vector2(float(base.position[0]), float(base.position[1]))})
+		if not _same(sim.supply.bases, expected): return "supply_bases"
+	return ""
+
+static func _context(sim: BattleSim) -> Dictionary:
+	var roster: Array = []
+	for fleet in sim.st.fleets: roster.append({"id": fleet.id, "side": fleet.side, "faction": fleet.faction})
+	return {
+		"profile_id": sim.profile_id, "seed": sim.st.seed_id, "hz": sim.st.hz,
+		"tick": sim.st.tick, "clock_ms": sim.st.clock_ms, "roster": roster,
+		"rules": sim.R.duplicate(true), "scenario": sim.rs.scenario.duplicate(true),
+		"combat": sim.salvo.C.duplicate(true) if sim.salvo != null else {},
+		"detection_derived": {"period": sim.detect._period, "conf0": sim.detect._conf0, "zones": sim.detect.terr.zones.duplicate(true)} if sim.detect != null else {},
+		"supply_derived": {"ship": sim.supply.ship, "need": sim.supply.need, "light_ticks": sim.supply.light_ticks, "still_eps": sim.supply.still_eps, "bases": sim.supply.bases.duplicate(true)} if sim.supply != null else {},
+	}
+
+static func _preflight(target: BattleSim, packet: Dictionary) -> String:
+	if not _data(packet): return "unsupported_value"
+	if not _keys(packet, ["format", "context", "detection", "supply"]): return "packet_fields"
+	if typeof(packet.format) != TYPE_STRING or packet.format != FORMAT: return "unsupported_format"
+	if not _same(packet.context, _context(target)): return "context_mismatch"
+	if not _keys(packet.detection, ["active", "contacts"]) or not _keys(packet.supply, ["active", "fleets"]): return "module_fields"
+	if typeof(packet.detection.active) != TYPE_BOOL or typeof(packet.supply.active) != TYPE_BOOL: return "module_type"
+	if packet.detection.active != (target.detect != null) or packet.supply.active != (target.supply != null): return "module_layout"
+	if not packet.detection.contacts is Array or not packet.supply.fleets is Array: return "module_container"
+	var ids := {}
+	var source_keys := {"": true}
+	for fleet in target.st.fleets:
+		if ids.has(fleet.id): return "duplicate_target_id"
+		ids[fleet.id] = true
+		# A dead/stopped supplier may remain referenced until the next step.
+		source_keys["f%d" % fleet.id] = true
+	if target.supply != null:
+		for base in target.supply.bases: source_keys[base.key] = true
+	if target.detect == null:
+		if not packet.detection.contacts.is_empty(): return "inactive_contacts"
+	else:
+		if packet.detection.contacts.size() != 2: return "contact_sides"
+		for book in packet.detection.contacts:
+			if not book is Dictionary: return "contact_book"
+			for id in book:
+				if typeof(id) != TYPE_INT or not ids.has(id): return "contact_id"
+				var record: Variant = book[id]
+				if not _keys(record, RECORD_FIELDS): return "contact_fields"
+				if typeof(record.seen) != TYPE_INT or record.seen < 0 or record.seen > target.st.tick: return "contact_seen"
+				if typeof(record.pos) != TYPE_VECTOR2 or typeof(record.err_r) != TYPE_FLOAT or record.err_r < 0.0: return "contact_geometry"
+				if typeof(record.state) != TYPE_STRING or record.state not in ["confirmed", "estimated", "lost"]: return "contact_state"
+				if typeof(record.conf_bp) != TYPE_INT or record.conf_bp < 0 or record.conf_bp > BattleRules.BP: return "contact_confidence"
+	if target.supply == null:
+		if not packet.supply.fleets.is_empty(): return "inactive_supply"
+	else:
+		if packet.supply.fleets.size() != target.st.fleets.size(): return "fleet_count"
+		for i in packet.supply.fleets.size():
+			var entry: Variant = packet.supply.fleets[i]
+			if not _keys(entry, ["id", "values"]): return "fleet_fields"
+			if typeof(entry.id) != TYPE_INT or entry.id != target.st.fleets[i].id: return "fleet_order"
+			var values: Variant = entry.values
+			if not _keys(values, SUP_FIELDS): return "supply_fields"
+			for field in SUP_FIELDS:
+				if typeof(values[field]) != typeof(target.st.fleets[i].get(field)): return "supply_type"
+			if not source_keys.has(values.sup_src): return "supply_source"
+			if values.sup_first != -1 and not ids.has(values.sup_first): return "supply_priority_id"
+			if values.sup_since < -1 or values.sup_since > target.st.tick: return "supply_since"
+			for field in ["sup_prog", "sup_n", "sup_ammo", "sup_mat"]:
+				if values[field] < 0: return "negative_supply"
+	return ""
\ No newline at end of file
