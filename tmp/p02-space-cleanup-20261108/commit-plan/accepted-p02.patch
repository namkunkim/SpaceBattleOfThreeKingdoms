+func _run_operation_replay_cli() -> void:
+	var adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+	var replay := preload("res://core/battle/operation_replay.gd")
+	var options := _operation_options(OS.get_cmdline_user_args(), "--operation-replay")
+	if not options.ok:
+		_operation_reject(options)
+		return
+	var output_error := _operation_output_error(options.out)
+	if output_error != "":
+		_operation_reject(adapter.fail(output_error, "out"))
+		return
+	var input_file := FileAccess.open(options.input, FileAccess.READ)
+	if input_file == null:
+		_operation_reject(adapter.fail("input_read_failed", "input"))
+		return
+	var length := input_file.get_length()
+	if length > replay.MAX_BYTES:
+		input_file.close()
+		_operation_reject(adapter.fail("replay_input_limit", "input"))
+		return
+	var bytes := input_file.get_buffer(length)
+	var read_error := input_file.get_error()
+	input_file.close()
+	if bytes.size() != length or read_error not in [OK, ERR_FILE_EOF]:
+		_operation_reject(adapter.fail("input_read_failed", "input"))
+		return
+	var parser := JSON.new()
+	if parser.parse(bytes.get_string_from_utf8()) != OK:
+		_operation_reject(adapter.fail("invalid_json", "input"))
+		return
+	var hash := HashingContext.new()
+	hash.start(HashingContext.HASH_SHA256)
+	if not bytes.is_empty():
+		hash.update(bytes)
+	var result := replay.run(parser.data, hash.finish().hex_encode())
+	if not result.ok:
+		_operation_reject(result)
+		return
+	_write_operation_result(result, options.out)
+
+func _write_operation_result(result: Dictionary, out_path: String) -> void:
+	var adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+	# Recheck before WRITE. This is single-process no-clobber, not an OS lock.
+	var output_error := _operation_output_error(out_path)
+	if output_error != "":
+		_operation_reject(adapter.fail(output_error, "out"))
+		return
+	var output_text := JSON.stringify(result, "\t")
+	var output := FileAccess.open(out_path, FileAccess.WRITE)
+	if output == null:
+		_operation_reject(adapter.fail("output_open_failed", "out"))
+		return
+	output.store_string(output_text)
+	output.flush()
+	var write_error := output.get_error()
+	output.close()
+	if write_error != OK:
+		var failure := adapter.fail("output_write_failed", "out")
+		failure["partial_path"] = out_path
+		failure["file_error"] = write_error
+		failure["partial_bytes"] = FileAccess.get_file_as_bytes(out_path).size()
+		_operation_reject(failure)
+		return
+	if FileAccess.get_file_as_bytes(out_path).size() != output_text.to_utf8_buffer().size() or FileAccess.get_sha256(out_path) != output_text.sha256_text():
+		var failure := adapter.fail("output_verify_failed", "out")
+		failure["partial_path"] = out_path
+		failure["partial_bytes"] = FileAccess.get_file_as_bytes(out_path).size()
+		_operation_reject(failure)
+		return
+	print("OPERATION_HEADLESS_PASS " + JSON.stringify(result.summary))
+	quit(0)
