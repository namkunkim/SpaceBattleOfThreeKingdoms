+static func _operation_options(args: PackedStringArray, input_option := "--operation-input") -> Dictionary:
+	var adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+	if "--operation-replay" in args and ("--operation-input" in args or "--operation-worker" in args):
+		return adapter.fail("conflicting_option", "--operation-replay")
+	if "--operation-input" in args and "--operation-worker" in args:
+		return adapter.fail("conflicting_option", "--operation-input")
