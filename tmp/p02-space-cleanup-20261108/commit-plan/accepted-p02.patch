diff --git a/tests/p02_headless_adapter.gd b/tests/p02_headless_adapter.gd
new file mode 100644
index 0000000000000000000000000000000000000000..6499897dd5aba0c9da2a1556fe96a3760a051c76
--- /dev/null
+++ b/tests/p02_headless_adapter.gd
@@ -0,0 +1,371 @@
+extends SceneTree
+
+const Adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+const Private := preload("res://core/battle/operation_private_state.gd")
+const Cli := preload("res://tests/autoresolve.gd")
+const OUT := "res://tmp/p02-first-integration-20261105/attempt1-observations.json"
+var checks := 0
+var failed := false
+var cases: Array = []
+var rejected := {}
+var natural := 0
+var timeout := 0
+var policy_cases: Array = []
+var timeout_cases: Array = []
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func check(condition: bool, label: String) -> void:
+	checks += 1
+	if not condition:
+		failed = true
+		push_error("P02_ADAPTER_FAIL " + label)
+
+func same(a: Variant, b: Variant) -> bool:
+	if typeof(a) != typeof(b): return false
+	if a is Dictionary:
+		if not same(a.keys(), b.keys()): return false
+		for key in a:
+			if not same(a[key], b[key]): return false
+		return true
+	if a is Array:
+		if a.get_typed_builtin() != b.get_typed_builtin() or a.size() != b.size(): return false
+		for i in a.size():
+			if not same(a[i], b[i]): return false
+		return true
+	return a == b
+
+# Independent enumeration of actual script variables, not capture field lists.
+func properties(value: Object, excluded: Array = []) -> Dictionary:
+	var out := {}
+	for item in value.get_property_list():
+		if int(item.usage) & PROPERTY_USAGE_SCRIPT_VARIABLE and str(item.name) not in excluded:
+			out[item.name] = plain(value.get(item.name))
+	return out
+
+func plain(value: Variant) -> Variant:
+	if value is Object: return properties(value)
+	if value is Dictionary:
+		var out := {}
+		for key in value: out[key] = plain(value[key])
+		return out
+	if value is Array:
+		var values: Array = []
+		for item in value: values.append(plain(item))
+		return {"type": value.get_typed_builtin(), "class": str(value.get_typed_class_name()), "script": value.get_typed_script().resource_path if value.get_typed_script() else "", "values": values}
+	return value
+
+func oracle(sim: BattleSim) -> Dictionary:
+	return {"state": properties(sim.st, ["_idx", "_idx_n"]),
+		"sim": properties(sim, ["st", "salvo", "terrain", "detect", "supply", "morale", "victory", "cai", "decisions", "chain", "cmd", "assault", "skills"]),
+		"salvo": properties(sim.salvo, ["sim", "C", "terr"]) if sim.salvo else {},
+		"terrain": properties(sim.terrain) if sim.terrain else {},
+		"detect": properties(sim.detect, ["sim", "D", "terr"]) if sim.detect else {},
+		"supply": properties(sim.supply, ["sim", "S"]) if sim.supply else {}}
+
+func input(kind := "poc") -> Dictionary:
+	return JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/p02/" + kind + ".json"))
+
+# Expected fixture ints are explicit independently of the adapter converter.
+func raw_profile(kind: String) -> Dictionary:
+	var p: Dictionary = input(kind).profile
+	p.ally[0].ships = 30 if kind == "poc" else 4
+	p.foe[0].ships = 1 if kind == "poc" else 40
+	for fleet in p.ally + p.foe:
+		fleet.lv = 1
+		fleet.p = 0
+		if kind == "services":
+			fleet.command = 70
+			fleet.start_morale_bp = 10000
+	if kind == "services":
+		p.ally[0].composition[0].count = 1
+		p.ally[0].composition[1].count = 1
+		p.ally[0].composition[2].count = 2
+		p.foe[0].composition[0].count = 40
+	return p
+
+func cleanup(sim: BattleSim) -> void:
+	for key in ["salvo", "detect", "supply"]:
+		var module: Variant = sim.get(key)
+		if module: module.sim = null
+
+func close_checked(owner: OperationPrivateState) -> void:
+	var held: Array = []
+	for key in ["salvo", "detect", "supply"]:
+		var module: Variant = owner._sim.get(key)
+		if module: held.append(module)
+	owner.close()
+	for module in held: check(module.sim == null, "close breaks module binding")
+	check(owner.read_projection(0).error == "unprepared_owner", "close projection")
+	check(owner.summary().error == "unprepared_owner", "close summary")
+
+# Independent policy oracle: constructs exact command dictionaries directly
+# from the public DTO, without either production policy implementation.
+func reference_commands(policy: String, projection: Dictionary) -> Array:
+	var result: Array = []
+	if policy != "attack5" or int(projection.tick) % (5 * int(projection.hz)) != 0: return result
+	var live_allies: Array = []
+	var targetable: Array = []
+	for row in projection.squadrons:
+		if row.side == 0:
+			if not row.dead: live_allies.append(row)
+		elif row.has("contact"):
+			if row.contact in ["confirmed", "estimated"]: targetable.append(row)
+		elif not row.dead: targetable.append(row)
+	if live_allies.is_empty(): return result
+	var ids: Array = []
+	for ally in live_allies:
+		ids.append(ally.id)
+		var nearest := -1
+		var distance := 1e9
+		for index in targetable.size():
+			var measured: float = (ally.pos as Vector2).distance_to(targetable[index].pos)
+			if measured < distance:
+				nearest = index
+				distance = measured
+		if nearest >= 0:
+			result.append({"tick": -1, "side": 0, "ids": [ally.id], "kind": "attack", "target_id": targetable[nearest].id, "point": Vector2.ZERO, "args": {}})
+	for kind in ["missile", "fighter"]:
+		result.append({"tick": -1, "side": 0, "ids": ids.duplicate(), "kind": kind, "target_id": -1, "point": Vector2.ZERO, "args": {}})
+	return result
+
+func tuples(commands: Array) -> Array:
+	var result: Array = []
+	for command in commands:
+		check(command.tick == -1 and command.side == 0 and command.point == Vector2.ZERO and command.args.is_empty(), "micro command defaults")
+		result.append([command.kind, command.ids, command.target_id])
+	return result
+
+func policy_microcases() -> void:
+	var ally := {"id": 1, "side": 0, "dead": false, "pos": Vector2.ZERO}
+	var dead_ally := {"id": 2, "side": 0, "dead": true, "pos": Vector2.ZERO}
+	var full := {"id": 3, "side": 1, "dead": false, "pos": Vector2(10, 0)}
+	var full_dead := {"id": 4, "side": 1, "dead": true, "pos": Vector2(1, 0)}
+	var confirmed := {"id": 3, "side": 1, "contact": "confirmed", "pos": Vector2(10, 0)}
+	var estimated := {"id": 4, "side": 1, "contact": "estimated", "pos": Vector2(20, 0)}
+	var lost := {"id": 3, "side": 1, "contact": "lost", "pos": Vector2(1, 0)}
+	var tie_first := {"id": 4, "side": 1, "contact": "confirmed", "pos": Vector2(-10, 0)}
+	var finish := [["missile", [1], -1], ["fighter", [1], -1]]
+	var rows := [
+		["P01", "none", 0, [ally, confirmed], []],
+		["P02", "attack5", 0, [ally, dead_ally, full, full_dead], [["attack", [1], 3]] + finish],
+		["P03", "attack5", 50, [ally, confirmed], [["attack", [1], 3]] + finish],
+		["P04", "attack5", 50, [ally, estimated], [["attack", [1], 4]] + finish],
+		["P05", "attack5", 50, [ally, lost, estimated], [["attack", [1], 4]] + finish],
+		["P06", "attack5", 50, [ally, lost], finish],
+		["P07", "attack5", 49, [ally, confirmed], []],
+		["P08", "attack5", 50, [ally, tie_first, confirmed], [["attack", [1], 4]] + finish],
+		["P09", "attack5", 50, [{"id": 1, "side": 0, "dead": true, "pos": Vector2.ZERO}, confirmed], []]]
+	for row in rows:
+		var projection := {"tick": row[2], "hz": 10, "squadrons": row[3]}
+		var before := var_to_bytes(projection)
+		var actual := tuples(Cli._operation_policy_commands(row[1], projection))
+		var reference := tuples(reference_commands(row[1], projection))
+		check(same(actual, row[4]), row[0] + " production hardcoded oracle")
+		check(same(reference, row[4]), row[0] + " reference hardcoded oracle")
+		check(var_to_bytes(projection) == before, row[0] + " public DTO preserved")
+		policy_cases.append({"id": row[0], "actual": actual, "reference": reference, "expected": row[4]})
+
+func timeout_case(seed_id: int) -> void:
+	var data := input("timeout-poc")
+	data.seed = seed_id
+	var created := Adapter.create(data)
+	check(created.ok, "timeout factory")
+	if not created.ok: return
+	var owner: OperationPrivateState = created.owner
+	var profile: Dictionary = data.profile.duplicate(true)
+	for fleet in profile.ally + profile.foe:
+		fleet.ships = 30
+		fleet.lv = 1
+		fleet.p = 0
+	var raw := BattleSim.new(seed_id, 10, profile)
+	for fleet in raw.st.fleets: fleet.control = "direct"
+	raw.projection(0)
+	check(not raw.st.over and raw.st.tick == 0 and raw.st.clock_ms == 0 and raw.st.alive(0).size() == 1 and raw.st.alive(1).size() == 1, "timeout raw initial survival")
+	check(same(oracle(owner._sim), oracle(raw)), "timeout initial full oracle")
+	var run := Cli.run_operation(owner, "none", 1)
+	raw.step()
+	# Match the consumer's aggregation container without weakening exact equality.
+	# drain_events itself is typed Array[Dictionary]; the run DTO accumulates into
+	# an untyped Array, even for one step and even when there are no events.
+	var expected_events: Array = []
+	expected_events.append_array(raw.drain_events())
+	check(run.ok and same(run.events, expected_events) and same(oracle(owner._sim), oracle(raw)), "timeout raw one step")
+	var summary: Dictionary = run.summary
+	check(summary.tick == 1 and summary.clock_ms == 100 and not summary.over and summary.reason == "timeout" and summary.end_tick == -1 and summary.end_ms == -1 and summary.commands == 0, "timeout exact DTO")
+	check(raw.st.alive(0).size() == 1 and raw.st.alive(1).size() == 1, "timeout raw afterstep survival")
+	timeout_cases.append({"id": "T01" if seed_id == 0 else "T02", "seed": seed_id, "summary": summary, "event_count": run.events.size()})
+	close_checked(owner)
+	cleanup(raw)
+
+func normal(seed_id: int, kind: String, policy: String) -> void:
+	var data := input(kind)
+	data.seed = seed_id
+	data.policy = policy
+	var before := var_to_bytes(data)
+	var made := Adapter.create(data)
+	check(made.ok, "factory " + kind)
+	if not made.ok: return
+	check(not made.meta.has("profile") and not made.has("value"), "factory metadata no profile")
+	var owner: OperationPrivateState = made.owner
+	var raw := BattleSim.new(seed_id, 10, raw_profile(kind))
+	for i in 2: raw.st.fleets[i].control = ["direct", "delegate"][i]
+	raw.projection(0) # Same documented initial public observation, not capture.
+	check(same(oracle(owner._sim), oracle(raw)), "initial full independent state")
+	check(owner.summary().summary.tick == 0 and owner.summary().summary.clock_ms == 0 and owner._sim._queue.is_empty(), "C0 clock queue")
+	var events: Array = []
+	var expected_events: Array = []
+	var intermediate := []
+	while not raw.st.over and raw.st.tick < 1200:
+		var projected := owner.read_projection(0)
+		var public_raw := raw.projection(0)
+		check(projected.ok and same(projected.projection, public_raw), "public projection")
+		if raw.st.tick in [5, 10, 15]:
+			var before_read := oracle(owner._sim)
+			var summary := owner.summary()
+			summary.summary.tick = -99
+			projected.projection.squadrons[0].name = "mutated"
+			check(same(before_read, oracle(owner._sim)), "read aliases detached/no queue or event consumption")
+			check(owner.read_projection(0).projection.squadrons[0].name != "mutated" and owner.summary().summary.tick == raw.st.tick, "read alias future reads")
+			intermediate.append(owner.summary().summary)
+		if raw.st.tick == 1:
+			var immediate := BattleSim.command(0, [1], "stop")
+			check(owner.issue(immediate).ok, "immediate issue")
+			raw.issue(immediate.duplicate(true))
+			check(same(oracle(owner._sim), oracle(raw)), "issue immediate oracle")
+			var before_reject := oracle(owner._sim)
+			check(owner.issue(BattleSim.command(0, [1], "charge")).error == "unsupported_command", "unsupported issue")
+			check(same(before_reject, oracle(owner._sim)), "failed command atomic")
+			var pending := BattleSim.command(0, [1], "attack", 2)
+			check(owner.queue(pending).ok, "pending queue")
+			raw.queue(pending.duplicate(true))
+			check(owner._sim.st.tick == 1 and owner._sim._queue.size() == 1, "queue before next step")
+		for command in Cli._operation_policy_commands(policy, owner.read_projection(0).projection):
+			check(owner.queue(command).ok, "policy queue")
+		for command in reference_commands(policy, public_raw): raw.queue(command)
+		check(same(oracle(owner._sim), oracle(raw)), "prestep ordered queue")
+		check(owner.advance().ok, "advance")
+		raw.step()
+		check(same(oracle(owner._sim), oracle(raw)), "poststep full independent state")
+		var drained := owner.drain_events()
+		var expected := raw.drain_events()
+		check(drained.ok and same(drained.events, expected), "ordered events")
+		events.append_array(drained.events)
+		expected_events.append_array(expected)
+		check(owner.drain_events().events.is_empty(), "event consumed once")
+	var summary: Dictionary = owner.summary().summary
+	check(summary.tick == raw.st.tick and summary.clock_ms == raw.st.clock_ms and summary.fp == raw.fingerprint(), "clock summary fingerprint")
+	check(summary.commands == raw.command_log.size() and same(events, expected_events), "command count ordered events")
+	check(not events.is_empty(), "actual event generation")
+	if raw.st.over: natural += 1
+	else: timeout += 1
+	check(var_to_bytes(data) == before, "input unchanged")
+	# The actual consumer is compared to raw commands produced independently.
+	var twin: Dictionary = Adapter.create(data)
+	check(twin.ok, "fresh twin")
+	var twin_raw := BattleSim.new(seed_id, 10, raw_profile(kind))
+	for i in 2: twin_raw.st.fleets[i].control = ["direct", "delegate"][i]
+	twin_raw.projection(0)
+	var run := Cli.run_operation(twin.owner, policy, 1200)
+	var twin_events: Array = []
+	while not twin_raw.st.over and twin_raw.st.tick < 1200:
+		for command in reference_commands(policy, twin_raw.projection(0)): twin_raw.queue(command)
+		twin_raw.step()
+		twin_events.append_array(twin_raw.drain_events())
+	check(run.ok and same(run.events, twin_events), "actual consumer helper ordered events")
+	check(same(oracle(twin.owner._sim), oracle(twin_raw)), "actual consumer independent full state")
+	cases.append({"seed": seed_id, "profile": kind, "policy": policy, "summary": summary, "consumer_summary": run.summary, "event_count": events.size(), "checkpoints": intermediate})
+	close_checked(owner)
+	close_checked(twin.owner)
+	cleanup(raw)
+	cleanup(twin_raw)
+
+func reject(id: String, data: Variant, code: String, path: String) -> void:
+	var before := var_to_bytes(data)
+	var result := Adapter.create(data)
+	check(not result.ok and result.error == code and result.path == path and not result.has("owner"), id + " error/path/no owner " + str(result))
+	check(var_to_bytes(data) == before, id + " input preserved")
+	rejected[id] = {"error": result.get("error"), "path": result.get("path")}
+
+func negatives() -> void:
+	var data := input()
+	data.erase("profile"); reject("N02", data, "missing_field", "profile")
+	for row in [["N04", "mode", "other", "unsupported_mode"], ["N05", "format", "other", "unsupported_input_representation"], ["N06", "extra", 1, "unsupported_field"], ["N07", "seed", 0.5, "invalid_integer"], ["N09", "hz", 20, "unsupported_hz"], ["N10", "initial_controls", ["direct"], "initial_controls"]]:
+		data = input(); data[row[1]] = row[2]; reject(row[0], data, row[3], row[1])
+	data = input(); data.profile.ally[0].ships = 1.5; reject("N08", data, "invalid_integer", "profile.ally[0].ships")
+	data = input(); data.initial_controls[0] = "other"; reject("N11", data, "initial_controls", "initial_controls[0]")
+	data = input(); data.profile.reinf = [{}]; reject("N12", data, "unsupported_reinforcement", "profile.reinf")
+	data = input("services"); data.profile.combat.morale = {}; reject("N13", data, "unsupported_module_config", "profile.combat")
+	data = input(); data.definition = {}; reject("N16", data, "unsupported_input_representation", "definition")
+	data = input(); data.checkpoint = {}; reject("N17", data, "unsupported_checkpoint", "checkpoint")
+	data = input(); data.profile.extra = 1; reject("N18", data, "unsupported_profile_field", "profile")
+	reject("X01", [], "invalid_container", "$")
+	data = input(); data.profile.ally = 5; reject("X02", data, "invalid_container", "profile.ally")
+	data = input(); data.profile.ally[0] = 5; reject("X03", data, "invalid_container", "profile.ally[0]")
+	data = input(); data.profile.ally[0].composition = 5; reject("X04", data, "invalid_container", "profile.ally[0].composition")
+	data = input(); data.profile.ally[0].composition = [5]; reject("X05", data, "invalid_container", "profile.ally[0].composition[0]")
+	for row in [["X06", "seed", 1e30], ["X07", "max_ticks", 1e30], ["X11", "seed", true], ["X12", "max_ticks", INF]]:
+		data = input(); data[row[1]] = row[2]; reject(row[0], data, "invalid_integer", row[1])
+	data = input(); data.profile.ally[0].ships = 1e30; reject("X08", data, "invalid_integer", "profile.ally[0].ships")
+	data = input(); data.profile.ally[0].composition = [{"count": 1e30}]; reject("X09", data, "invalid_integer", "profile.ally[0].composition[0].count")
+	data = input(); data.profile.ally[0].composition = [{"count": 2147483647}, {"count": 1}]; reject("X10", data, "integer_total_overflow", "profile.ally[0].composition")
+	var created := Adapter.create(input("services"))
+	check(created.ok, "negative read owner")
+	if not created.ok: return
+	var owner: OperationPrivateState = created.owner
+	for row in [["Y01", 0.0], ["Y02", 2]]:
+		var before := oracle(owner._sim)
+		var result := owner.read_projection(row[1])
+		check(not result.ok and result.error == "invalid_side" and result.path == "side", row[0])
+		check(same(before, oracle(owner._sim)) and owner.read_projection(0).ok, "invalid side nonmutation/recovery")
+		rejected[row[0]] = {"error": result.error, "path": result.path}
+	owner._busy = true
+	for row in [["Y03", "read_projection"], ["Y05", "summary"]]:
+		var result: Dictionary = owner.read_projection(0) if row[1] == "read_projection" else owner.summary()
+		check(not result.ok and result.error == "busy" and result.path == "owner", row[0])
+		rejected[row[0]] = {"error": result.error, "path": result.path}
+	owner._busy = false
+	check(owner.issue(BattleSim.command(0, [1], "stop")).ok, "normal issue after read failure")
+	close_checked(owner)
+	for row in [["Y04", "read_projection"], ["Y06", "summary"]]:
+		var result: Dictionary = owner.read_projection(0) if row[1] == "read_projection" else owner.summary()
+		check(not result.ok and result.error == "unprepared_owner" and result.path == "owner", row[0])
+		rejected[row[0]] = {"error": result.error, "path": result.path}
+	# Technical maxima are tested purely; no enormous simulation is allocated.
+	data = input(); data.seed = 4294967295.0; data.max_ticks = 2147483647.0
+	data.profile.ally[0].ships = 2147483647.0
+	data.profile.ally[0].composition = [{"count": 2147483647.0}]
+	var pure := Adapter.normalize(data)
+	check(pure.ok, "pure maximum")
+	if pure.ok:
+		check(typeof(pure.value.seed) == TYPE_INT and pure.value.seed == 4294967295, "seed maximum int")
+		check(typeof(pure.value.max_ticks) == TYPE_INT and pure.value.max_ticks == 2147483647, "tick maximum int")
+		check(typeof(pure.value.profile.ally[0].ships) == TYPE_INT and pure.value.profile.ally[0].ships == 2147483647 and pure.value.profile.ally[0].composition[0].count == 2147483647, "fleet/count maximum int")
+		pure.value.profile.ally[0].name = "changed"
+		check(data.profile.ally[0].name == "A", "pure result detached")
+	# Existing active runtime survives factory failure; caller ownership is separate.
+	created = Adapter.create(input())
+	var before := oracle(created.owner._sim)
+	data = input(); data.profile.reinf = [{}]
+	check(not Adapter.create(data).ok and same(before, oracle(created.owner._sim)), "factory failure preserves existing owner")
+	close_checked(created.owner)
+
+func _run() -> void:
+	check(Private._classes() == "", "canonical runtime paths")
+	if Private._classes() != "": quit(1); return
+	policy_microcases()
+	for seed_id in [0, 7]: timeout_case(seed_id)
+	for seed_id in [0, 7]:
+		for kind in ["poc", "services"]:
+			for policy in ["none", "attack5"]: normal(seed_id, kind, policy)
+	negatives()
+	check(cases.size() == 8 and rejected.size() == 32, "exact API denominator")
+	check(policy_cases.size() == 9 and timeout_cases.size() == 2, "exact supplemental denominator")
+	check(natural > 0, "natural end exercised")
+	var result := {"ok": not failed, "checks": checks, "cases": cases, "rejections": rejected, "policy_microcases": policy_cases, "timeout_cases": timeout_cases, "natural": natural, "timeout": timeout, "class_guard": Private._classes()}
+	var output := FileAccess.open(OUT, FileAccess.WRITE)
+	output.store_string(JSON.stringify(result, "\t"))
+	output.close()
+	print("P02_ADAPTER_%s cases=%d checks=%d rejections=%d natural=%d timeout=%d" % ["FAIL" if failed else "PASS", cases.size(), checks, rejected.size(), natural, timeout])
+	quit(1 if failed else 0)
diff --git a/tests/p02_replay_adapter.gd b/tests/p02_replay_adapter.gd
new file mode 100644
index 0000000000000000000000000000000000000000..14a5542fa6d410395485f639702cf6c03bbb95f6
--- /dev/null
+++ b/tests/p02_replay_adapter.gd
@@ -0,0 +1,69 @@
+extends SceneTree
+
+const Replay := preload("res://core/battle/operation_replay.gd")
+const Adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+const Evidence := "res://tmp/p02-third-20261108/"
+var checks := 0
+var failed := 0
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func check(value: bool, label: String) -> void:
+	checks += 1
+	if not value:
+		failed += 1
+		push_error("P02_REPLAY_FAIL " + label)
+
+func fixture(name: String) -> Dictionary:
+	return JSON.parse_string(FileAccess.get_file_as_string(Evidence + "matrix/" + name + ".json"))
+
+func check_closed(name: String, expected: Dictionary) -> void:
+	var data := fixture(name)
+	var created := Adapter.create(data.input)
+	check(created.ok, name + " factory creation")
+	if not created.ok:
+		return
+	var owner: OperationPrivateState = created.owner
+	var result := Replay._play_and_close(created, data.commands)
+	check(result.get("ok") == expected.ok, name + " completion status")
+	if expected.ok and result.ok:
+		check(var_to_bytes(result.summary) == var_to_bytes(expected.summary), name + " native summary types")
+		check(var_to_bytes(result.events) == var_to_bytes(expected.events), name + " native event types and order")
+		check(result.event_count == expected.event_count and result.commands_consumed == expected.commands_consumed, name + " native counts")
+	elif not expected.ok:
+		check(result == expected, name + " exact failure")
+	check(owner.summary() == Adapter.fail("unprepared_owner", "owner"), name + " owner closed")
+	check(owner._sim == null, name + " sim detached")
+
+func _run() -> void:
+	var file := FileAccess.open(Evidence + "oracle.native", FileAccess.READ)
+	var oracle: Dictionary = file.get_var()
+	file.close()
+	for name in ["commands", "reordered", "removed", "defaults", "one-tick", "natural", "direct", "delegate"]:
+		var oracle_key: String = {"commands": "expected", "one-tick": "one_tick"}.get(name, name)
+		var expected: Dictionary = oracle[oracle_key].duplicate()
+		expected["ok"] = true
+		check_closed(name, expected)
+		var created := Adapter.create(fixture(name).input)
+		if created.ok:
+			var owner: OperationPrivateState = created.owner
+			var initial := owner.observe()
+			var expected_initial: Array = ["delegate", "delegate"] if name == "defaults" else expected.controls
+			check(initial.ok and initial.fleets.map(func(fleet: Dictionary): return fleet.control) == expected_initial, name + " initial native controls")
+			owner.close()
+	check_closed("late", Adapter.fail("replay_unconsumed_command", "commands[0].tick"))
+	check_closed("order", Adapter.fail("replay_command_order", "commands[1].tick"))
+	check_closed("policy", Adapter.fail("unsupported_replay_policy", "input.policy"))
+	check_closed("limit", Adapter.fail("replay_tick_limit", "input.max_ticks"))
+	check_closed("rows", Adapter.fail("replay_command_limit", "commands"))
+	check_closed("commands-shape", Adapter.fail("invalid_replay_command", "commands"))
+	check(oracle.reordered.summary.fp != oracle.expected.summary.fp and oracle.reordered.events != oracle.expected.events, "reorder changes native state and events")
+	check(oracle.removed.events != oracle.expected.events and oracle.removed.commands_consumed + 1 == oracle.expected.commands_consumed, "removal changes native events and count")
+	check(oracle.defaults.summary.fp == oracle.legacy_fingerprint, "legacy default controls common window")
+	check(oracle.expected.events[-1].kind == "rejected" and oracle.expected.events[-1].tick == 2 and typeof(oracle.expected.events[-1].pos) == TYPE_VECTOR2, "last processed tick native rejection")
+	check(oracle.natural.events[-1].kind == "battle_end" and oracle.natural.events[-1].tick == oracle.natural.summary.end_tick, "natural end event preserved")
+	check(oracle.one_tick.summary.tick == 1 and oracle.one_tick.summary.clock_ms == 100 and not oracle.one_tick.summary.over and oracle.one_tick.summary.end_tick == -1 and oracle.one_tick.summary.end_ms == -1, "one tick cap remains non-terminal")
+	check(oracle.direct.controls != oracle.delegate.controls, "explicit controls differ in native state")
+	print("P02_REPLAY_%s cases=14 assertions=%d" % ["PASS" if failed == 0 else "FAIL", checks])
+	quit(0 if failed == 0 else 1)
diff --git a/tests/p02_viewer_events.gd b/tests/p02_viewer_events.gd
new file mode 100644
index 0000000000000000000000000000000000000000..a9d02eea79b594611cded4a613b60cd87e76e491
--- /dev/null
+++ b/tests/p02_viewer_events.gd
@@ -0,0 +1,296 @@
+extends SceneTree
+
+const Adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+const Private := preload("res://core/battle/operation_private_state.gd")
+const Service := preload("res://core/battle/operation_service_state.gd")
+const SERVICE_FIXTURE := "res://tests/fixtures/p02/services.json"
+const SEED := 0
+const HZ := 10
+const CONTROLS := ["direct", "direct"]
+const FAR_STEPS := 1
+const NEAR_STEPS := 1200
+
+func input(scenario: String) -> Dictionary:
+	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(SERVICE_FIXTURE))
+	data.seed = SEED
+	data.hz = HZ
+	data.initial_controls = CONTROLS.duplicate()
+	data.policy = "none"
+	data.max_ticks = NEAR_STEPS
+	if scenario == "clear":
+		data.profile.combat.erase("detection")
+	if scenario == "near":
+		# Scout radar sees 225 units. The enemy's ordinary view does not.
+		# Artillery's 260-unit range permits a natural asymmetric engagement.
+		data.profile.ally[0].composition = [{"ship_type_id": "SHP-03", "count": 3}, {"ship_type_id": "SHP-06", "count": 1}]
+		data.profile.foe[0].ships = 4
+		data.profile.foe[0].composition = [{"ship_type_id": "SHP-04", "count": 4}]
+		data.profile.foe[0].x = 625
+	else:
+		data.profile.foe[0].x = 1550
+	return data
+
+func typed_profile(scenario: String) -> Dictionary:
+	# Construct the native profile directly from trusted rules/combat and typed
+	# roster literals. Do not use adapter normalization or an owner observation.
+	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(SERVICE_FIXTURE))
+	var combat: Dictionary = data.profile.combat
+	if scenario == "clear":
+		combat.erase("detection")
+	var near := scenario == "near"
+	var ally_comp := [{"ship_type_id": "SHP-01", "count": 1}, {"ship_type_id": "SHP-03", "count": 1}, {"ship_type_id": "SHP-04", "count": 2}]
+	if near:
+		ally_comp = [{"ship_type_id": "SHP-03", "count": 3}, {"ship_type_id": "SHP-06", "count": 1}]
+	var ally := {"name": "A", "role": "A", "ships": 4, "lv": 1, "x": 400.0, "y": 500.0,
+		"p": 0, "flag": true, "composition": ally_comp, "formation_id": "FRM-01", "command": 70, "start_morale_bp": 10000}
+	var foe := {"name": "B", "role": "B", "ships": 4 if near else 40, "lv": 1,
+		"x": 625.0 if near else 1550.0, "y": 500.0, "p": 0, "flag": true,
+		"composition": [{"ship_type_id": "SHP-04" if near else "SHP-02", "count": 4 if near else 40}],
+		"formation_id": "FRM-01", "command": 70, "start_morale_bp": 10000}
+	return {"profile_id": "p02-explicit-services", "rules": data.profile.rules,
+		"ally": [ally], "foe": [foe], "reinf": [], "combat": combat}
+
+func native(scenario: String) -> BattleSim:
+	var sim := BattleSim.new(SEED, HZ, typed_profile(scenario))
+	for i in CONTROLS.size():
+		sim.st.fleets[i].control = CONTROLS[i]
+	sim.projection(0)
+	return sim
+
+func clean(sim: BattleSim) -> void:
+	for field in ["salvo", "detect", "supply"]:
+		var module: Variant = sim.get(field)
+		if module:
+			module.sim = null
+
+func stop_commands() -> Array[Dictionary]:
+	return [BattleSim.command(0, [1], "stop"), BattleSim.command(1, [2], "stop")]
+
+func prepare_native(sim: BattleSim, steps: int) -> void:
+	for command in stop_commands():
+		sim.issue(command)
+	for i in steps:
+		sim.step()
+
+
+var checks := 0
+var failures := 0
+var rows := 0
+
+func require(condition: bool, message: String) -> void:
+	checks += 1
+	if not condition:
+		failures += 1
+		printerr("VIEWER_FAIL ", message)
+
+func report(row: String, prior: int, details := {}) -> void:
+	rows += 1
+	print("VIEWER_ROW ", row, " ", "PASS" if failures == prior else "FAIL", " ", JSON.stringify(details))
+
+func make_owner(scenario: String, steps: int) -> OperationPrivateState:
+	var result := Adapter.create(input(scenario))
+	require(result.ok, "restricted input accepted: " + str(result.get("error", "")))
+	if not result.ok:
+		return null
+	var owner: OperationPrivateState = result.owner
+	for command in stop_commands():
+		require(owner.issue(command).ok, "owner immediate stop")
+	for i in steps:
+		if not owner.advance().ok:
+			require(false, "owner advance")
+			break
+	return owner
+
+func native_events(scenario: String, steps: int, side: int) -> Array[Dictionary]:
+	var sim := native(scenario)
+	prepare_native(sim, steps)
+	var events := sim.drain_events() if side == -1 else sim.drain_events_for(side)
+	clean(sim)
+	return events
+
+func same_events(actual: Array, expected: Array) -> bool:
+	return actual.is_typed() and actual.get_typed_builtin() == TYPE_DICTIONARY and Service._same(actual, expected)
+
+func events_for(events: Array, kind: String, id: int) -> Array:
+	return events.filter(func(event: Dictionary): return event.kind == kind and event.sq == id)
+
+func compare(owner: OperationPrivateState, side: int, expected: Array[Dictionary]) -> Array:
+	var actual := owner.drain_events_for(side)
+	require(actual.keys() == ["ok", "events"] and actual.ok, "successful drain DTO")
+	var events: Array = actual.get("events", [])
+	require(same_events(events, expected), "exact event type/order/value for side %d" % side)
+	return events
+
+func test_matrix() -> void:
+	var index := 0
+	for scenario in ["clear", "far"]:
+		for side in [0, 1]:
+			var prior := failures
+			var raw := native_events(scenario, FAR_STEPS, -1)
+			var filtered := native_events(scenario, FAR_STEPS, side)
+			require(raw.size() == 4 and events_for(raw, "say", 1).size() == 1 and events_for(raw, "say", 2).size() == 1, "two identifiable immediate stops")
+			require(raw[2].tick == 0 and raw[3].tick == 0 and typeof(raw[3].pos) == TYPE_VECTOR2, "same-tick ordering and native position type")
+			var owner := make_owner(scenario, FAR_STEPS)
+			if owner:
+				compare(owner, side, filtered)
+				owner.close()
+			var hidden_id: int = 2 - side
+			if scenario == "clear":
+				require(same_events(filtered, raw), "clear: both sides retain raw events")
+			else:
+				var reversed := native_events(scenario, FAR_STEPS, 1 - side)
+				require(filtered.size() == 2 and events_for(filtered, "say", hidden_id).is_empty(), "fog: hidden opposing stop")
+				require(not same_events(raw, filtered) and not same_events(reversed, filtered), "raw replacement and side swap are rejected by the oracle")
+			index += 1
+			report("E%02d" % index, prior, {"raw": raw.size(), "filtered": filtered.size(), "side": side, "opposing_id": hidden_id})
+
+func test_contact_and_masks() -> void:
+	var prior := failures
+	var early := native_events("near", 0, 0)
+	var late := native_events("near", 1, 0)
+	var opposite := native_events("near", 1, 1)
+	require(events_for(early, "say", 2).is_empty(), "foe not visible before first scan")
+	require(events_for(late, "say", 2).size() == 1 and events_for(late, "say", 2)[0].tick == 0, "drain-time contact reveals an earlier event")
+	var contacts := events_for(late, "contact", 2)
+	require(contacts.size() == 1 and contacts[0].value == {"state": "confirmed", "was": "none"} and contacts[0].tick == 1, "real first-step contact")
+	require(events_for(opposite, "contact", 2).is_empty(), "contact only for side 0")
+	for spec in [[0, 0, early], [1, 0, late], [1, 1, opposite]]:
+		var owner := make_owner("near", spec[0])
+		if owner:
+			compare(owner, spec[1], spec[2])
+			owner.close()
+	report("E05", prior, {"before": early.size(), "after_side0": late.size(), "after_side1": opposite.size(), "contacts": contacts.size()})
+
+	prior = failures
+	var raw := native_events("near", NEAR_STEPS, -1)
+	var masked := native_events("near", NEAR_STEPS, 1)
+	var salvo_raw := events_for(raw, "salvo", 1)
+	var salvo_mask := events_for(masked, "salvo", -1)
+	var loss_raw := events_for(raw, "ship_lost", 2)
+	var loss_mask := events_for(masked, "ship_lost", 2)
+	require(salvo_raw.size() == 2 and salvo_mask.size() == 2, "naturally fired salvos become anonymous")
+	for i in mini(salvo_raw.size(), salvo_mask.size()):
+		var expected: Dictionary = salvo_raw[i].duplicate(true)
+		expected.sq = -1
+		require(Service._same(salvo_mask[i], expected), "salvo actor only is masked")
+	require(loss_raw.size() == 1 and loss_mask.size() == 1, "naturally observed ship loss")
+	if loss_raw.size() == 1 and loss_mask.size() == 1:
+		var expected: Dictionary = loss_raw[0].duplicate(true)
+		require(expected.other == 1, "raw ship loss identifies the source")
+		expected.other = -1
+		require(Service._same(loss_mask[0], expected), "loss source only is masked")
+	var owner := make_owner("near", NEAR_STEPS)
+	if owner:
+		compare(owner, 1, masked)
+		owner.close()
+	report("E06", prior, {"raw": raw.size(), "filtered": masked.size(), "masked_salvos": salvo_mask.size(), "masked_losses": loss_mask.size()})
+
+func test_shared_queue() -> void:
+	var prior := failures
+	var owner := make_owner("far", FAR_STEPS)
+	if owner:
+		compare(owner, 0, native_events("far", FAR_STEPS, 0))
+		require(owner.drain_events().events.is_empty(), "filtered drain consumes hidden events in raw queue")
+		require(owner.drain_events_for(1).events.is_empty(), "other side cannot receive drained events")
+		owner.close()
+	owner = make_owner("far", FAR_STEPS)
+	if owner:
+		compare(owner, 1, native_events("far", FAR_STEPS, 1))
+		require(owner.drain_events_for(0).events.is_empty(), "opposite-first also consumes queue")
+		owner.close()
+	report("E07", prior)
+
+	prior = failures
+	owner = make_owner("far", FAR_STEPS)
+	if owner:
+		require(same_events(owner.drain_events().events, native_events("far", FAR_STEPS, -1)), "raw still returns both sides")
+		require(owner.drain_events_for(0).events.is_empty() and owner.drain_events_for(1).events.is_empty(), "raw then filtered is empty")
+		owner.close()
+	report("E08", prior)
+
+func test_errors() -> void:
+	var index := 9
+	for invalid in [false, 0.0, "0", -1]:
+		var prior := failures
+		var owner := make_owner("far", FAR_STEPS)
+		if owner:
+			var original := owner._sim._events
+			var snapshot := owner.capture_completed()
+			require(snapshot.ok, "pre-error capture")
+			require(owner.drain_events_for(invalid) == {"ok": false, "error": "invalid_side", "path": "side"}, "exact Variant validation")
+			require(is_same(original, owner._sim._events) and original.size() == 4, "invalid request preserves queue identity")
+			require(Service._same(snapshot, owner.capture_completed()), "invalid request preserves entire captured owner")
+			compare(owner, 0, native_events("far", FAR_STEPS, 0))
+			owner.close()
+		report("E%02d" % index, prior, {"type": type_string(typeof(invalid)), "value": invalid})
+		index += 1
+	var prior := failures
+	var owner := make_owner("far", FAR_STEPS)
+	if owner:
+		var snapshot := owner.capture_completed()
+		var original := owner._sim._events
+		owner._busy = true
+		require(owner.drain_events_for(false) == {"ok": false, "error": "busy", "path": "owner"}, "busy has precedence over invalid side")
+		require(owner.drain_events_for(0) == {"ok": false, "error": "busy", "path": "owner"}, "busy refuses valid side")
+		require(owner._busy and is_same(original, owner._sim._events), "busy and queue identity preserved")
+		owner._busy = false
+		require(snapshot.ok and Service._same(snapshot, owner.capture_completed()), "busy request preserves entire captured owner")
+		compare(owner, 1, native_events("far", FAR_STEPS, 1))
+		owner.close()
+		require(owner.drain_events_for(false) == {"ok": false, "error": "unprepared_owner", "path": "owner"}, "closed has precedence over invalid side")
+		require(owner.drain_events_for(0) == {"ok": false, "error": "unprepared_owner", "path": "owner"}, "closed refuses valid side")
+	report("E13", prior)
+
+func test_copy_and_state() -> void:
+	var prior := failures
+	var owner := make_owner("near", NEAR_STEPS)
+	if owner:
+		var sim := native("near")
+		prepare_native(sim, NEAR_STEPS)
+		var pending := BattleSim.command(0, [1], "stop")
+		sim.queue(pending)
+		require(owner.queue(pending).ok, "nonempty pending command queue")
+		var original := owner._sim._events
+		var original_copy := original.duplicate(true)
+		var original_salvos := events_for(original, "salvo", 1)
+		var before := owner.capture_completed()
+		var summary := owner.summary()
+		require(before.ok and summary.ok, "capture and summary available before drain")
+		var expected := sim.drain_events_for(1)
+		var result := compare(owner, 1, expected)
+		var after := owner.capture_completed()
+		require(after.ok and after.packet.view.sim._events.is_empty() and sim._events.is_empty(), "both captures align with native queue consumption")
+		if before.ok and after.ok:
+			require(same_events(before.packet.view.sim._events, native_events("near", NEAR_STEPS, -1)), "pre-drain capture stores native raw events")
+			before.packet.view.sim._events = sim._events
+			require(Service._same(before, after), "capture changes only by removal of events")
+			require(Service._same(after.packet.view.sim._queue, sim._queue) and Service._same(after.packet.view.sim.command_log, sim.command_log), "native command queue and log")
+			require(after.packet.view.state.tick == sim.st.tick and after.packet.view.state.clock_ms == sim.st.clock_ms and after.packet.controls == CONTROLS, "native clock and initial controls")
+		require(Service._same(summary, owner.summary()) and summary.summary.fp == sim.fingerprint(), "summary unchanged and native fingerprint")
+		for side in [0, 1]:
+			require(Service._same(owner.read_projection(side).projection, sim.projection(side)), "native projection after drain")
+		var returned_salvos := events_for(result, "salvo", -1)
+		require(not original_salvos.is_empty() and not returned_salvos.is_empty(), "real nested payload in both queue and output")
+		if not original_salvos.is_empty() and not returned_salvos.is_empty():
+			var original_payload: Dictionary = original_salvos[0].value
+			returned_salvos[0].value.cat = "mutated"
+			returned_salvos[0].sq = 999
+			result.clear()
+			require(original_payload.cat == "artillery" and same_events(original, original_copy), "nested/output mutations cannot alias pre-drain owner queue")
+		clean(sim)
+		owner.close()
+	report("E14", prior)
+
+func _initialize() -> void:
+	require(Private._classes() == "", "canonical runtime class resource paths")
+	if failures != 0:
+		quit(1)
+		return
+	test_matrix()
+	test_contact_and_masks()
+	test_shared_queue()
+	test_errors()
+	test_copy_and_state()
+	require(rows == 14, "fixed logical denominator")
+	print("P02_VIEWER_EVENTS_", "PASS" if failures == 0 else "FAIL", " rows=", rows, " assertions=", checks)
+	quit(0 if failures == 0 else 1)
diff --git a/tests/p02_worker_adapter.gd b/tests/p02_worker_adapter.gd
new file mode 100644
index 0000000000000000000000000000000000000000..6619b82af6fb159cdc4d15ebb1240186673eebd3
--- /dev/null
+++ b/tests/p02_worker_adapter.gd
@@ -0,0 +1,136 @@
+extends SceneTree
+
+const Baseline := preload("res://tests/p02_headless_adapter.gd")
+const Adapter := preload("res://core/battle/operation_runtime_adapter.gd")
+var failures := 0
+var checks := 0
+var running_frames := 0
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func check(condition: bool, label: String) -> void:
+	checks += 1
+	if not condition:
+		failures += 1
+		push_error("P02_WORKER_FAIL " + label)
+
+func fixture(kind: String) -> Dictionary:
+	return JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/p02/worker-" + kind + ".json"))
+
+# Direct native oracle. The fixture fleet integer assignments are explicit and
+# the oracle never reads normalized input, owner state or the worker result.
+func reference(kind: String) -> Dictionary:
+	var data := fixture(kind)
+	var p: Dictionary = data.profile
+	p.ally[0].ships = 4 if kind == "services" else 30
+	p.foe[0].ships = {"poc": 1, "services": 40, "timeout-poc": 30}[kind]
+	for fleet in p.ally + p.foe:
+		fleet.lv = 1
+		fleet.p = 0
+		if kind == "services":
+			fleet.command = 70
+			fleet.start_morale_bp = 10000
+	if kind == "services":
+		p.ally[0].composition[0].count = 1
+		p.ally[0].composition[1].count = 1
+		p.ally[0].composition[2].count = 2
+		p.foe[0].composition[0].count = 40
+	var sim := BattleSim.new(0, 10, p)
+	for fleet in sim.st.fleets:
+		fleet.control = "delegate"
+	sim.projection(0)
+	var events: Array = []
+	var st := sim.st
+	while not st.over and st.tick < int(data.max_ticks):
+		sim.step()
+		events.append_array(sim.drain_events())
+	var summary := {"tick": st.tick, "clock_ms": st.clock_ms, "over": st.over,
+		"win": st.over and st.win, "reason": st.end_reason if st.over else "timeout",
+		"t": st.end_ms / 1000.0 if st.over else st.clock_s(), "end_tick": st.end_tick, "end_ms": st.end_ms,
+		"lost": st.lost / 1000.0, "killed": st.killed / 1000.0,
+		"reinf_t": st.reinf_ms / 1000.0 if st.reinf else -1.0,
+		"ally_alive": st.alive(0).size(), "foe_alive": st.alive(1).size(),
+		"fp": sim.fingerprint(), "commands": sim.command_log.size()}
+	for field in ["salvo", "detect", "supply"]:
+		var module: Variant = sim.get(field)
+		if module: module.sim = null
+	return {"summary": summary, "events": events}
+
+func joined(resolver: AutoResolver) -> Dictionary:
+	var value := resolver.poll_operation()
+	while value.get("status") == "running":
+		running_frames += 1
+		if value != {"ok": true, "status": "running"}:
+			failures += 1
+			push_error("P02_WORKER_FAIL running has no result")
+		await process_frame
+		value = resolver.poll_operation()
+	return value
+
+func _run() -> void:
+	var resolver := AutoResolver.new(null)
+	check(resolver.get_script().resource_path == "res://scripts/world/auto_resolver.gd", "canonical resolver")
+	check(resolver.poll_operation().status == "idle", "initial idle")
+	var cycle: Array = []
+	cycle.append(cycle)
+	for input in [RefCounted.new(), cycle, {"value": INF}]:
+		check(resolver.start_operation(input) == Adapter.fail("invalid_worker_input", "input"), "plain input rejection")
+	cycle.clear()
+	check(resolver.start_operation({"checkpoint": {}}).ok, "worker started for adapter rejection")
+	check(await joined(resolver) == Adapter.fail("unsupported_checkpoint", "checkpoint"), "joined worker rejection")
+	var negative := fixture("poc")
+	negative.initial_controls[0] = "direct"
+	check(resolver.start_operation(negative).ok, "worker started for post-create rejection")
+	check(await joined(resolver) == Adapter.fail("worker_requires_delegate", "initial_controls"), "joined support rejection")
+	check(resolver.start_operation(fixture("services")).ok, "cancel setup")
+	resolver.cancel_operation()
+	check(resolver.poll_operation().status == "idle", "cancelled unpublished result discarded")
+	check(resolver.start_operation(fixture("timeout-poc")).ok, "completed but unpublished cancel setup")
+	# Inspect only the Thread lifecycle, never an owner, sim or partial result.
+	while resolver._operation_thread.is_alive():
+		await process_frame
+	check(resolver.start_operation(fixture("timeout-poc")) == Adapter.fail("busy", "worker"), "terminated but unjoined remains busy")
+	resolver.cancel_operation()
+	check(resolver.poll_operation().status == "idle", "completed but unpublished result discarded")
+	for kind in ["poc", "services", "timeout-poc"]:
+		var data := fixture(kind)
+		var before := var_to_bytes(data).hex_encode().sha256_text()
+		var expected := reference(kind)
+		check(resolver.start_operation(data) == {"ok": true, "status": "running"}, kind + " start")
+		data.profile.ally[0].ships = 999
+		data.initial_controls[0] = "direct"
+		check(resolver.start_operation(data) == Adapter.fail("busy", "worker"), "duplicate start busy before join")
+		check(not resolver.start() and resolver.run_blocking() == null, "legacy start guards")
+		check(not resolver.poll() and resolver.outcome == null and resolver.sim == null, "no legacy state")
+		check(resolver.clock_s() == 0.0 and resolver.progress() == 0.0 and resolver.army_bp() == [0, 0], "no legacy publication")
+		var got := await joined(resolver)
+		check(got.ok, kind + " joined success")
+		if not got.ok:
+			continue
+		check(got.keys() == ["ok", "summary", "events", "event_count", "meta"], "result fields")
+		check(var_to_bytes(got.summary) == var_to_bytes(expected.summary), kind + " native summary with types")
+		check(var_to_bytes(got.events) == var_to_bytes(expected.events), kind + " native events with order and types")
+		check(got.event_count == expected.events.size(), kind + " event count")
+		check(got.meta == {"format": Adapter.FORMAT, "transform": "identity/no-transform", "input_sha256": before, "executor": "worker"}, "meta including input snapshot")
+		var kinds: Dictionary = {}
+		for event in got.events:
+			kinds[event.kind] = int(kinds.get(event.kind, 0)) + 1
+		print("P02_WORKER_OBSERVATION " + JSON.stringify({"fixture": kind, "summary": got.summary, "event_kinds": kinds}))
+		if kind == "timeout-poc":
+			check(not got.summary.over and got.summary.tick == 1 and got.summary.clock_ms == 100 and got.summary.reason == "timeout" and got.summary.end_tick == -1 and got.summary.end_ms == -1, "timeout sentinel")
+		else:
+			check(got.summary.over and not got.events.is_empty() and got.events[-1].kind == "battle_end" and got.events[-1].tick == got.summary.end_tick, kind + " natural terminal event")
+		if kind == "services":
+			for event_kind in ["contact", "salvo", "ship_lost"]:
+				check(kinds.has(event_kind), "services " + event_kind)
+		var original := var_to_bytes(got)
+		got.summary.tick = -99
+		if not got.events.is_empty():
+			got.events[0].kind = "mutated"
+		got.meta.executor = "mutated"
+		resolver.cancel_operation()
+		check(resolver.start_operation(RefCounted.new()).error == "invalid_worker_input", "invalid start after publication")
+		check(var_to_bytes(resolver.poll_operation()) == original, "published result isolated")
+	print("P02_WORKER_CHECKS %d running_frames_observed=%d" % [checks, running_frames])
+	quit(1 if failures else 0)
