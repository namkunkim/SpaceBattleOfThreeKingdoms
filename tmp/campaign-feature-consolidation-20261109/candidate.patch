+	if kind == "projectile":
+		return {"profile_id": "p2c-restricted-poc", "rules": rules, "ally": [{"name": "A", "role": "A", "ships": 30, "lv": 1, "x": 500, "y": 500, "p": 0, "flag": true}], "foe": [{"name": "B", "role": "B", "ships": 30, "lv": 1, "x": 750, "y": 500, "p": 0, "flag": true}], "reinf": []}
