@@ -0,0 +1,41 @@
+"""Build the isolated P05 demo input from the reviewed offline probes."""
+
+import contextlib
+import io
+import json
+from pathlib import Path
+import runpy
+import sys
+
+
+DESIGN = Path(__file__).resolve().parents[2] / "docs/battle-core/pc-campaign-design"
+
+
+def build():
+    access = runpy.run_path(str(DESIGN / "p05_map_access_validation_20261109.py"))
+    capture = io.StringIO()
+    with contextlib.redirect_stdout(capture):
+        access["main"]()
+    result = json.loads(capture.getvalue())
+    envelope = runpy.run_path(str(DESIGN / "p05_formation_envelope_probe_20261109.py"))
+    radii = {
+        name: entry["max_transition_order_independent"]
+        for name, entry in envelope["measure"]().items()
+    }
+    return {
+        "schema": "p05-access-demo-v1",
+        "envelope": "p05-layout-disks-v1",
+        "space": "effective",
+        "nodes": access["NODES"],
+        "world": [access["WIDTH"], access["HEIGHT"]],
+        "edge": access["EDGE"],
+        "corridor": access["HALF_CORRIDOR"],
+        "offset": access["PAIR_OFFSET"],
+        "radii": radii,
+        "regions": {key: access[key] for key in ("E_DEPLOY", "E_EXIT", "SUPPLY", "R_DEPLOY", "C_GOAL")},
+        "witness": result,
+    }
+
+
+if __name__ == "__main__":
+    Path(sys.argv[1]).write_text(json.dumps(build(), indent=2), encoding="utf-8")
diff --git a/tools/p05_access_demo/demo.gd b/tools/p05_access_demo/demo.gd
new file mode 100644
index 0000000..22c181c
--- /dev/null
+++ b/tools/p05_access_demo/demo.gd
@@ -0,0 +1,229 @@
+extends Node2D
+
+const Guard = preload("res://guard.gd")
+const SCALE := 0.55
+const ORIGIN := Vector2(48, 78)
+const INK := Color("#e1efff")
+const ROUTE_COLORS := {"EJAC": Color("#54e0c6"), "EJBDC": Color("#88aeff"), "RC": Color("#ffa96b")}
+
+var manifest: Dictionary
+var mode := "WindowsManual"
+var evidence := ""
+var results: Array[Dictionary] = []
+var witnesses: Dictionary = {}
+var failures := 0
+var button: Button
+var output: Label
+
+
+func _ready() -> void:
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with("--mode="):
+			mode = arg.trim_prefix("--mode=")
+		if arg.begins_with("--evidence="):
+			evidence = arg.trim_prefix("--evidence=")
+	var loaded: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://manifest.json"))
+	if not loaded is Dictionary or loaded.get("schema") != "p05-access-demo-v1" or loaded.get("envelope") != "p05-layout-disks-v1" or loaded.get("space") != "effective":
+		push_error("P05 manifest not valid")
+		get_tree().quit(2)
+		return
+	manifest = loaded
+	button = Button.new()
+	button.text = "Run P05 access checks"
+	button.position = Vector2(48, 12)
+	button.size = Vector2(220, 45)
+	add_child(button)
+	button.pressed.connect(_start_checks)
+	output = Label.new()
+	output.position = Vector2(290, 20)
+	output.text = "P05 isolated native route validation"
+	add_child(output)
+	queue_redraw()
+	if mode in ["Headless", "WindowsAuto"]:
+		button.pressed.emit.call_deferred()
+
+
+func _record(label: String, ok: bool, extra: Dictionary = {}) -> void:
+	var result := {"case": label, "pass": ok}
+	result.merge(extra)
+	results.append(result)
+	if not ok:
+		failures += 1
+
+
+func _summary(g: Guard) -> Dictionary:
+	var state := g.snapshot()
+	var point: Vector2 = state.plan
+	var centers := []
+	for p: Vector2 in state.positions:
+		centers.append([p.x, p.y])
+	return {"plan": [point.x, point.y], "centers": centers,
+		"heading_deg": rad_to_deg(state.heading), "tick": state.tick, "route_index": state.index,
+		"returning": state.returning, "moving": state.moving, "visits": state.visits,
+		"complete": state.complete}
+
+
+func _snapshot(g: Guard) -> Dictionary:
+	return {"state": g.snapshot(), "route": g.route_id, "points": g.points.duplicate(),
+		"offsets": g.offsets.duplicate(), "radii": g.radii.duplicate(),
+		"neck": g.neck, "bad_service": g.inaccessible_service}
+
+
+func _transaction(g: Guard, before: Dictionary) -> Dictionary:
+	var after := _snapshot(g)
+	return {"unchanged": after == before, "before": before, "after": after}
+
+
+func _advance(g: Guard, index: int) -> String:
+	var remaining := 6000
+	while g.state.index < index and remaining > 0:
+		var problem := g.step()
+		if problem != "":
+			return problem
+		remaining -= 1
+	return "" if g.state.index == index else "step_limit"
+
+
+func _positive(id: String) -> void:
+	var g := Guard.new(manifest)
+	var problem := g.start(id)
+	_record(id + "_entry", problem == "", {"reason": problem})
+	if problem != "":
+		return
+	if id != "RC":
+		problem = _advance(g, 2)
+		if problem == "":
+			problem = g.visit("service")
+		_record(id + "_service_stop", problem == "", {"reason": problem, "state": _summary(g)})
+		if problem != "":
+			return
+		var stop: Vector2 = g.state.plan
+		problem = _advance(g, 3)
+		_record(id + "_service_departure", problem == "" and g.state.plan != stop, {"reason": problem})
+		if problem != "":
+			return
+	problem = _advance(g, g.points.size() - 1)
+	if problem == "":
+		problem = g.visit("goal")
+	_record(id + "_goal_access", problem == "", {"reason": problem, "state": _summary(g)})
+	if problem != "":
+		return
+	witnesses[id] = g.snapshot()
+	if id != "RC":
+		problem = g.return_to_e()
+		if problem == "":
+			problem = _advance(g, g.points.size() - 1)
+		if problem == "":
+			problem = g.visit("exit")
+		_record(id + "_explicit_return_exit", problem == "" and g.state.complete,
+			{"reason": problem, "state": _summary(g)})
+
+
+func _negative() -> void:
+	var g := Guard.new(manifest)
+	g.start("EJAC")
+	var prior := _snapshot(g)
+	var problem := g.step([Vector2.ZERO, Vector2(1.5, 1.5)])
+	_record("tracking_rejection_preserves_entire_group", problem == "tracking_budget" and _snapshot(g) == prior,
+		{"reason": problem, "transaction": _transaction(g, prior)})
+	var forward := g.points[0].direction_to(g.points[1])
+	problem = g.step([Vector2.ZERO, forward])
+	_record("speed_rejection_preserves_entire_group", problem == "step_speed" and _snapshot(g) == prior,
+		{"reason": problem, "transaction": _transaction(g, prior)})
+	problem = g.step()
+	_record("tracking_valid_retry", problem == "" and g.state.tick == prior.state.tick + 1 and g.state.positions != prior.state.positions,
+		{"reason": problem, "state": _summary(g)})
+	g.start("EJAC", true)
+	for _i in 6000:
+		prior = _snapshot(g)
+		problem = g.step()
+		if problem != "":
+			break
+	_record("physical_throat_rejects_sweep", problem == "throat_clearance" and _snapshot(g) == prior,
+		{"reason": problem, "transaction": _transaction(g, prior)})
+	g.start("EJAC", false, true)
+	problem = _advance(g, 2)
+	prior = _snapshot(g)
+	if problem == "":
+		problem = g.visit("service")
+	_record("active_service_outside_legal_center_preserves_state", problem == "service_inaccessible" and _snapshot(g) == prior,
+		{"reason": problem, "transaction": _transaction(g, prior)})
+	var old_index: int = g.state.index
+	problem = _advance(g, old_index + 1)
+	_record("inaccessible_service_route_still_open", problem == "" and g.state.index == old_index + 1, {"reason": problem})
+	prior = _snapshot(g)
+	problem = g.start("INVALID")
+	_record("invalid_start_preserves_active_route", problem == "unknown_route" and _snapshot(g) == prior,
+		{"reason": problem, "transaction": _transaction(g, prior)})
+
+
+func _start_checks() -> void:
+	button.disabled = true
+	results.clear()
+	witnesses.clear()
+	failures = 0
+	for id in ["EJAC", "EJBDC", "RC"]:
+		_positive(id)
+	_negative()
+	output.text = "%d/%d checks passed  |  isolated P05" % [results.size() - failures, results.size()]
+	queue_redraw()
+	var display := DisplayServer.get_name()
+	var info := {"schema": manifest.schema, "mode": mode, "os": OS.get_name(), "display": display,
+		"godot": Engine.get_version_info(), "device": RenderingServer.get_video_adapter_name(),
+		"window": str(DisplayServer.window_get_size()), "results": results}
+	if mode != "Headless":
+		await RenderingServer.frame_post_draw
+		await RenderingServer.frame_post_draw
+		var frame := get_viewport().get_texture().get_image()
+		var nonuniform := not frame.is_empty() and frame.get_pixel(5, 5) != frame.get_pixel(80, 33)
+		var png_result := ERR_INVALID_PARAMETER
+		if nonuniform and not evidence.is_empty():
+			png_result = frame.save_png(evidence.path_join("P05-Windows-frame.png"))
+		info["frame"] = {"completed": true, "nonuniform": nonuniform, "save_result": png_result,
+			"width": frame.get_width(), "height": frame.get_height()}
+		if mode == "WindowsAuto" and (OS.get_name() != "Windows" or display == "headless" or png_result != OK):
+			failures += 1
+	info["failures"] = failures
+	var encoded := JSON.stringify(info)
+	print("P05_RESULT " + encoded)
+	if not evidence.is_empty():
+		var file := FileAccess.open(evidence.path_join(mode + ".json"), FileAccess.WRITE)
+		if file == null:
+			failures += 1
+		else:
+			file.store_string(JSON.stringify(info, "  ") + "\n")
+	if mode == "WindowsManual":
+		button.disabled = false
+	else:
+		get_tree().quit(0 if failures == 0 else 1)
+
+
+func _map_point(p: Vector2) -> Vector2:
+	return ORIGIN + p * SCALE
+
+
+func _draw() -> void:
+	if manifest.is_empty():
+		return
+	var map := Rect2(ORIGIN, Guard.vec(manifest.world) * SCALE)
+	draw_rect(map, Color("#152338"))
+	draw_rect(map, Color("#3a526b"), false, 2.0)
+	for id in ROUTE_COLORS:
+		var path := PackedVector2Array()
+		for p in manifest.witness[id].points:
+			path.append(_map_point(Guard.vec(p)))
+		draw_polyline(path, ROUTE_COLORS[id], 3.0, true)
+	for id in manifest.nodes:
+		var p := _map_point(Guard.vec(manifest.nodes[id]))
+		draw_circle(p, 6.0, INK)
+		draw_string(ThemeDB.fallback_font, p + Vector2(9, -8), id, HORIZONTAL_ALIGNMENT_LEFT, -1, 19, INK)
+	for id in witnesses:
+		var indexes := ["RC-CAO-SQ-05"] if id == "RC" else ["RC-LIU-SQ-01", "RC-LIU-SQ-02"]
+		for i in indexes.size():
+			var p := _map_point(witnesses[id].positions[i])
+			var radius := (float(manifest.radii[indexes[i]]) + Guard.TRACK + Guard.SAFETY) * SCALE
+			draw_circle(p, radius, Color(ROUTE_COLORS[id], 0.20))
+			draw_arc(p, radius, 0, TAU, 48, ROUTE_COLORS[id], 1.5, true)
+	draw_string(ThemeDB.fallback_font, Vector2(48, 738),
+		"Teal  front route     Blue  detour     Orange  reinforcements     Circles  stopped goal-access witnesses",
+		HORIZONTAL_ALIGNMENT_LEFT, -1, 17, INK)
diff --git a/tools/p05_access_demo/guard.gd b/tools/p05_access_demo/guard.gd
new file mode 100644
index 0000000..f5c740d
--- /dev/null
+++ b/tools/p05_access_demo/guard.gd
@@ -0,0 +1,206 @@
+extends RefCounted
+
+const TRACK := 2.0
+const SAFETY := 1.0
+const DT := 0.1
+const SPEED := 20.0
+const TURN := deg_to_rad(36.0) * DT
+const EPS := 0.00001
+
+var data: Dictionary
+var route_id := ""
+var points: Array[Vector2] = []
+var offsets: Array[Vector2] = []
+var radii: Array[float] = []
+var state: Dictionary = {}
+var neck := false
+var inaccessible_service := false
+
+
+func _init(manifest: Dictionary) -> void:
+	data = manifest
+
+
+static func vec(v: Array) -> Vector2:
+	return Vector2(v[0], v[1])
+
+
+func node(id: String) -> Vector2:
+	return vec(data.nodes[id])
+
+
+func _positions(plan: Vector2) -> Array[Vector2]:
+	var positions: Array[Vector2] = []
+	for offset in offsets:
+		positions.append(plan + offset)
+	return positions
+
+
+func _radius(id: String) -> float:
+	return float(data.radii[id]) + TRACK + SAFETY
+
+
+func start(id: String, use_neck := false, bad_service := false) -> String:
+	if id not in ["EJAC", "EJBDC", "RC"]:
+		return "unknown_route"
+	var entry: Vector2 = node("R" if id == "RC" else "E")
+	var spawn_radius: float = float(data.regions.R_DEPLOY if id == "RC" else data.regions.E_DEPLOY)
+	var next_offsets: Array[Vector2] = [Vector2.ZERO]
+	var next_radii: Array[float] = [_radius("RC-CAO-SQ-05")]
+	if id != "RC":
+		var offset := Vector2(0.0, float(data.offset))
+		next_offsets = [-offset, offset]
+		next_radii = [_radius("RC-LIU-SQ-01"), _radius("RC-LIU-SQ-02")]
+	for i in next_offsets.size():
+		if next_offsets[i].length() + next_radii[i] > spawn_radius:
+			return "entry_clearance"
+		if not _inside_world(entry + next_offsets[i], next_radii[i]):
+			return "entry_world"
+	if next_offsets.size() == 2 and next_offsets[0].distance_to(next_offsets[1]) < next_radii[0] + next_radii[1]:
+		return "entry_interfleet"
+	route_id = id
+	neck = use_neck
+	inaccessible_service = bad_service
+	offsets = next_offsets
+	radii = next_radii
+	points.clear()
+	for p in data.witness[id].points:
+		points.append(vec(p))
+	state = {"plan": entry, "positions": _positions(entry), "index": 0,
+		"heading": (points[1] - entry).angle(), "tick": 0, "moving": false,
+		"returning": false, "visits": [], "complete": false}
+	return ""
+
+
+func _inside_world(p: Vector2, radius: float) -> bool:
+	var w := vec(data.world)
+	var inset := maxf(radius, float(data.edge))
+	return p.x >= inset and p.y >= inset and p.x <= w.x - inset and p.y <= w.y - inset
+
+
+func snapshot() -> Dictionary:
+	return state.duplicate(true)
+
+
+func at_stop() -> bool:
+	return state.plan == points[state.index]
+
+
+func step(perturbation: Array[Vector2] = []) -> String:
+	if state.complete or state.index >= points.size() - 1:
+		return "finished"
+	var index: int = state.index
+	var target := points[index + 1]
+	var plan: Vector2 = state.plan
+	var desired_heading := (target - points[index]).angle()
+	var next := snapshot()
+	next.tick += 1
+	if absf(angle_difference(state.heading, desired_heading)) > EPS:
+		next.heading = rotate_toward(state.heading, desired_heading, TURN)
+		next.moving = false
+	else:
+		next.plan = plan.move_toward(target, SPEED * DT)
+		next.moving = next.plan != target
+		if not next.moving:
+			next.index += 1
+	next.positions = _positions(next.plan)
+	if not perturbation.is_empty():
+		if perturbation.size() != next.positions.size():
+			return "position_arity"
+		for i in next.positions.size():
+			next.positions[i] += perturbation[i]
+	var problem := _swept(next, points[index], target)
+	if problem != "":
+		return problem
+	state = next
+	return ""
+
+
+func _swept(next: Dictionary, a: Vector2, b: Vector2) -> String:
+	var defender := node("C")
+	var defender_radius := _radius("RC-CAO-SQ-04")
+	var corridor: float = float(data.corridor)
+	for i in offsets.size():
+		var old: Vector2 = state.positions[i]
+		var new: Vector2 = next.positions[i]
+		if not new.is_finite() or new.distance_to(next.plan + offsets[i]) > TRACK:
+			return "tracking_budget"
+		if old.distance_to(new) > SPEED * DT + 0.001:
+			return "step_speed"
+		# Exact actual endpoints plus separate numeric reserve. The candidate
+		# nominal disks used for all other checks already include TRACK.
+		var swept_radius := radii[i] - TRACK
+		for p: Vector2 in [old, new]:
+			if not _inside_world(p, swept_radius):
+				return "world_boundary"
+			if p.distance_to(Geometry2D.get_closest_point_to_segment(p, a, b)) + swept_radius > corridor:
+				return "corridor_clearance"
+		if defender.distance_to(Geometry2D.get_closest_point_to_segment(defender, old, new)) < defender_radius + swept_radius:
+			return "defender_clearance"
+		if neck and route_id == "EJAC" and ((a == node("J") and b == node("A")) or (b == node("J") and a == node("A"))):
+			var j := node("J")
+			var axis := j.direction_to(node("A"))
+			var first := (old - j).dot(axis)
+			var last := (new - j).dot(axis)
+			var stations: Array = data.witness.negative.throat_station_bounds
+			if maxf(first, last) + swept_radius >= float(stations[0]) and minf(first, last) - swept_radius <= float(stations[1]):
+				var transverse := axis.orthogonal()
+				var cross := maxf(absf((old - j).dot(transverse)), absf((new - j).dot(transverse)))
+				if cross + swept_radius > float(data.witness.negative.throat_half_width):
+					return "throat_clearance"
+	if offsets.size() == 2:
+		var old_gap: Vector2 = state.positions[1] - state.positions[0]
+		var new_gap: Vector2 = next.positions[1] - next.positions[0]
+		var minimum_gap := Geometry2D.get_closest_point_to_segment(Vector2.ZERO, old_gap, new_gap).length()
+		if minimum_gap < radii[0] + radii[1] - 2.0 * TRACK:
+			return "interfleet_clearance"
+	return ""
+
+
+func visit(kind: String) -> String:
+	if state.complete or state.moving or not at_stop():
+		return "not_stopped"
+	if kind in state.visits:
+		return "already_visited"
+	var center: Vector2
+	var radius: float
+	match kind:
+		"service":
+			if route_id == "RC":
+				return "no_service"
+			var service_node := node("A" if route_id == "EJAC" else "B")
+			if not state.plan.is_equal_approx(service_node):
+				return "wrong_service_stop"
+			center = vec(data.witness.negative.inaccessible_service_center) if inaccessible_service else service_node
+			radius = float(data.witness.negative.inaccessible_service_radius if inaccessible_service else data.regions.SUPPLY)
+		"goal":
+			if state.returning or state.index != points.size() - 1:
+				return "wrong_goal_stop"
+			center = node("C")
+			radius = float(data.regions.C_GOAL)
+		"exit":
+			if not state.returning or state.index != points.size() - 1:
+				return "wrong_exit_stop"
+			center = node("E")
+			radius = float(data.regions.E_EXIT)
+		_:
+			return "unknown_region"
+	for p: Vector2 in state.positions:
+		if p.distance_to(center) + SAFETY > radius:
+			return kind + "_inaccessible"
+	var next := snapshot()
+	next.visits.append(kind)
+	next.complete = kind == "exit" or (route_id == "RC" and kind == "goal")
+	state = next
+	return ""
+
+
+func return_to_e() -> String:
+	if route_id == "RC" or state.returning or not "goal" in state.visits or state.moving:
+		return "cannot_return"
+	points.reverse()
+	var next := snapshot()
+	next.index = 0
+	next.returning = true
+	state = next
+	return ""
