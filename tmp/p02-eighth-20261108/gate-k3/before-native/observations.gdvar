"definitions": {
"assault_bp_order": "escort 배율 뒤에 더하고 [min_bp, max_bp]로 clamp한 다음 forced_div",
"damage_reduction_stack": "Q95: 받는 피해 감소는 가장 낮은 배율 하나만",
"distance_band_order": "contact > barrage > engagement > assault (가까울수록 작다). enemy_in_band b = 그 거리대 이내",
"holding": "이동 명령·경유점이 없고 후퇴·돌격 접근 중이 아니다(진형 전환 중은 holding)"
},
"no_duplicate_skill_in_fleet": true,
"note": "Q88~Q95·D4. 장수당 기술 1개(첫 특성). 특성 없는 장수는 기술 없음. 효과 키·조건 문법은 docs/battle-core/SPECIAL-SKILLS.md",
"skills": [{
"ai_when": {
"all": [{
"enemy_flagship_within": 100.0
}]
},
"duration_s": 60.0,
"effects": {
"assault_bp": 3000.0,
"assault_cd_reset": true,
"note": "재사용 대기 60초 = 지속 60초라 최대 2회 시도(의도)"
},
"id": "SK-U-GUANYU",
"kind": "unique",
"name": "만인지적",
"officer": "CHR-0107",
"relation": "combat.assault.elite_ids(관우 = 특급, 강습 개방 명중 1)는 상시 효과로 그대로 둔다. 이 특기는 그 위에 성공률을 더한다",
"requires": {
"has_ship_type": "SHP-01"
},
"status": "proposed",
"target": "self",
"text": "「만인지적」 — 60초 동안 강습 성공률 +30%p, 강습 재사용 대기 초기화. 강습모함이 있어야 쓴다.",
"trait": "만인지적"
}, {
"ai_when": {
"all": [{
"enemy_in_band": "barrage"
}]
},
"duration_s": 120.0,
"effects": {
"affinity_ignore": true,
"transition_mul_bp": 0.0
},
"id": "SK-U-ZHUGE",
"kind": "unique",
"name": "신기묘산",
"officer": "CHR-0134",
"relation": "formation_rules.master_trait(팔진 사용 자격)는 상시 효과로 그대로 둔다. 이 특기는 배치 재조정 1회를 진형 즉시 전환으로 옮긴 것이다",
"status": "proposed",
"target": "self",
"text": "「신기묘산」 — 120초 동안 진형 전환이 즉시 끝나고(전환 중 피해 ×0.8 없음), 진형 상성 불리를 받지 않는다.",
"trait": "신기묘산"
}, {
"ai_when": {
"all": [{
"ally_hull_below_bp_within": [4000.0, 200.0]
}]
},
"duration_s": 30.0,
"effects": {
"damage_taken_mul_bp": 0.0,
"rescue_equipped": true
},
"id": "SK-U-ZHAOYUN",
"kind": "unique",
"name": "일신시담",
"officer": "CHR-0136",
"radius": 200.0,
"relation": "commander_casualties 표의 '구조 장비 아군 함대 반경 안'을 효과 동안 이 함대에도 적용한다",
"requires": {
"ally_within": 200.0
},
"status": "proposed",
"target": "ally_fleet",
"target_pick": {
"by": "lowest_hull_ratio",
"from": "allied_fleets_in_radius",
"include_self": true,
"tie": "id"
},
"text": "「일신시담」 — 200 안의 아군 함대 하나(자기 포함): 30초 동안 받는 사격 피해 0, 지휘관 구조 판정에서 구조 함대로 본다.",
"trait": "일신시담"
}, {
"ai_when": {
"all": [{
"enemy_beyond_base_range_within_mul": ["artillery", 13000.0]
}]
},
"duration_s": 120.0,
"effects": {
"categories": ["artillery"],
"range_mul_bp": 13000.0
},
"id": "SK-U-HUANGZHONG",
"kind": "unique",
"name": "강궁",
"officer": "CHR-0138",
"relation": "사거리 원(P2)은 효과 중 늘어난 포격 사거리를 그려야 한다",
"status": "proposed",
"target": "self",
"text": "「강궁」 — 120초 동안 포격(미사일) 사거리 +30%.",
"trait": "강궁"
}, {
"ai_when": {
"all": [{
"wind_window_open": true
}]
},
"duration_s": 180.0,
"effects": {
"chain_power_mul_bp": 13000.0
},
"id": "SK-U-ZHOUYU",
"kind": "unique",
"name": "미주랑",
"officer": "CHR-0211",
"relation": "chain_operation.power_by_range에 곱한다(최대 0.5 → 0.65). 화공 발동·번짐 규칙은 그대로",
"status": "proposed",
"target": "side",
"text": "「미주랑」 — 180초 동안 연합 진영 화공 위력 +30%.",
"trait": "미주랑"
}, {
"ai_when": {
"all": [{
"chain_host_ai": true
}]
},
"duration_s": 0.0,
"effects": {
"alias_command": "letter"
},
"id": "SK-U-HUANGGAI",
"kind": "unique",
"name": "고육계",
"officer": "CHR-0217",
"relation": "새 효과가 없다. 기존 서신 명령(letter, feigned_surrender.letter_uses 1)을 슬롯에서 부르는 단축이다. 사용 여부도 letter_uses를 그대로 쓴다. AI는 기존 chain_host_ai를 따른다",
"requires": {
"chain_host": true
},
"status": "proposed",
"target": "self",
"text": "「고육계」 — 위장 항복 서신을 보낸다(화공 운용 함대만).",
"trait": "고육계"
}, {
"ai_when": {
"all": [{
"estimated_within": 600.0
}]
},
"duration_s": 120.0,
"effects": {
"reveal_orders": true,
"reveal_radius": 600.0
},
"id": "SK-U-GUOJIA",
"kind": "unique",
"name": "귀모",
"officer": "CHR-0003",
"relation": "탐지 규칙(진영 공유 Q46)으로 확인된 접촉은 진영 전체가 본다",
"status": "proposed",
"target": "self",
"text": "「귀모」 — 120초 동안 600 안의 적 함대를 확인 상태로 올리고 그 이동 목표를 보여 준다.",
"trait": "귀모"
}, {
"ai_when": {
"all": [{
"ally_flagship_within": 200.0
}, {
"ally_flagship_hull_below_bp": 8000.0
}]
},
"duration_s": 120.0,
"effects": {
"damage_redirect_bp": 5000.0
},
"id": "SK-U-DIANWEI",
"kind": "unique",
"name": "악래",
"officer": "CHR-0030",
"radius": 200.0,
"relation": "기함 함대가 받는 선체 피해의 50%를 이 함대가 대신 받는다. 같은 함대가 기함이면 효과 없음",
"requires": {
"ally_flagship_within": 200.0,
"self_not_flagship": true
},
"status": "proposed",
"target": "self",
"text": "「악래」 — 120초 동안 200 안의 아군 기함 함대가 받는 사격 피해의 절반을 대신 받는다.",
"trait": "악래"
}, {
"ai_when": {
"all": [{
"enemy_carrier_within": 200.0
}]
},
"duration_s": 120.0,
"effects": {
"assault_block": true
},
"id": "SK-U-XUCHU",
"include_self": true,
"kind": "unique",
"name": "호치",
"officer": "CHR-0047",
"radius": 200.0,
"relation": "combat.assault.flagship.escort_trait(호치, 기함 강습 성공률 ×0.5)는 상시 효과로 그대로 둔다. 이 특기는 효과 동안 반경 안 아군 함대에 대한 강습을 막는다",
"status": "proposed",
"target": "allies_in_radius",
"text": "「호치」 — 120초 동안 200 안의 아군 함대는 강습을 받지 않는다.",
"trait": "호치"
}, {
