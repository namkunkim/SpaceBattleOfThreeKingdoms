},
"id": "SK-U-DIANWEI",
"kind": "unique",
"name": "악래",
"officer": "CHR-0030",
"radius": 200.0,
"relation": "기함 함대가 받는 선체 피해의 50%를 이 함대가 대신 받는다. 같은 함대가 기함이면 효과 없음",
"requires": {
