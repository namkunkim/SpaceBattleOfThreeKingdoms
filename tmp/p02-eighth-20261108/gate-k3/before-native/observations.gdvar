"damage_taken_increase": "max_only",
"damage_taken_reduction": "min_only",
"note": "Q95: 받는 피해 감소(<10000)는 가장 낮은 배율 하나만, 증가(>10000)는 가장 큰 하나만 따로 고르고 둘을 곱한다",
"other": "multiply",
"speed_mul": "max_only",
"transition_mul": "min_only"
},
"status": "proposed",
"use_scope": "fleet_skill_pair",
"uses_per_battle": 1.0
},
"sun_support_ai": "손권군 전대는 아군 전대에서 300 안에 들어온 적에게 접근한다",
"what_if_cards": [{
"duration_s": 180.0,
"effect": "기류 창 시작을 배치 단계에서 한 번 고른다",
"id": "southeast_wind",
"name": "동남풍 「단 위의 사흘 밤」",
"pick_range_after_first_hit_s": [360.0, 720.0]
}, {
"effect": "형주 수군 을의 사기 −1000, 지휘관을 모개로 교체",
"id": "double_agent",
"morale_bp": -1000.0,
"name": "반간계 「장간의 서신」",
"replacement_commander": "CHR-0058",
"target_squadron_id": "RC-CAO-SQ-05"
}, {
"effect": "화공 표적 하나가 처음부터 분산 진형",
"id": "cheng_yu_insight",
"name": "정욱 간파 「가볍게 뜬 배」"
}],
"wind_window": {
"duration_s": 180.0,
"note": "시드로 시작 시각을 정하고 1막에 예보한다",
"start_after_first_hit_s": [540.0, 600.0]
}
},
"scenario_id": "RED-CLIFFS-208-RT"
},
"schema_version": 1
}
