+				dest = tp
+		var frozen := f.flip_wait > 0
+		var cfoe: FleetState = sight_foe(f, float(salvo.C.movement.contact_r)) if salvo else null   # 접적: 가까이 보이는 적 함대가 있다
+		var old_pos := f.pos
