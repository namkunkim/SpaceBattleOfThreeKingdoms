-# 이동 명령의 부속 상태(경유점, 평행 이동, 도착 방향)를 지운다
-func _clear_path(f: FleetState) -> void:
-	f.route.clear()
-	f.strafe = false
-	f.face_set = false
-	f.speed_cap = 0.0
-	f.move_grp = 0
-
-func _reject(lead: FleetState, reason: String, side: int) -> void:
-	emit("rejected", lead.id if lead else -1, side, Vector2.ZERO, reason)
