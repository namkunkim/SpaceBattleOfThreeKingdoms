-	emit("missile_launch", f.id, tgt.id, f.pos)
-
-func _launch_fighters(f: FleetState, tgt: FleetState) -> void:
-	var eid := st.new_event_id()
-	var s := BattleState.Swarm.new()
-	s.id = eid
-	s.src_id = f.id
