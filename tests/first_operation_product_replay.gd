extends SceneTree

const Codec := preload("res://scripts/first_operation_replay_codec.gd")
const Adapter := preload("res://scripts/first_operation_adapter.gd")
const Viewer := preload("res://scenes/FirstOperationReplayViewer.tscn")
const ID := "red-cliffs-first-operation-dev-v1/00000000000000000000000000000000"
const REQUEST := {"route_id":"flank","mode":"direct","seed":208,"difficulty":"standard",
	"definition_version":1,"definition_id":"red-cliffs-first-operation-dev-v1",
	"roster_id":"red-cliffs-dev-roster-v1","capability":"pc/first-operation-dev/1"}
const RESULT := {"kind":"withdrawal_success", "reason":"withdrawal_conditions_met",
	"id":ID+"/settlement", "operation_id":ID, "tick":1, "clock_ms":100}
var _checks := 0
var _failures := 0


class Playback extends RefCounted:
	var closed := 0
	var steps := 0

	func step() -> Dictionary:
		steps += 1
		return {"ok": true, "done": true, "frame": {"tick": 1, "clock_ms": 100,
			"projection": {"hz":10, "operation":{"settlement":RESULT}},
			"events": [{"tick":1,"kind":"operation_settled"}]}}

	func close() -> void:
		closed += 1


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	var folder := ProjectSettings.globalize_path("user://")
	var path := folder.path_join("fixture.pcopreplay")
	var bundle := {"format": Codec.RUN_FORMAT, "request": REQUEST,
		"operation_id":ID, "max_ticks":1, "commands":[{"tick":0,"kind":"withdraw"}],
		"expected_settlement": RESULT}
	_check(Codec.write(bundle, path).ok, "write replay")
	var before := FileAccess.get_sha256(path)
	var parsed := Codec.read(path)
	_check(parsed.ok and parsed.bundle.operation_id == ID and parsed.bundle.commands[0].tick == 0,
		"read record without changing origin identity")
	_check(Codec.write(bundle, path).get("error") == "replay_path_exists"
		and FileAccess.get_sha256(path) == before, "no overwrite")
	_check(Codec.read(path.replace(".pcopreplay", ".pcopsave")).get("error") == "replay_invalid_path",
		"no save file extension")
	var wrong := bundle.duplicate(true)
	wrong.format = "pc-first-operation-internal-replay/1"
	_check(Codec.write(wrong, folder.path_join("wrong.pcopreplay")).get("error") == "replay_invalid_bundle",
		"no checkpoint record")
	var damaged := folder.path_join("damaged.pcopreplay")
	var source := FileAccess.get_file_as_string(path)
	var envelope: Dictionary = JSON.parse_string(source)
	_write(damaged, source.replace(envelope.sha256, "0".repeat(64)))
	_check(Codec.read(damaged).get("error") == "replay_checksum_mismatch", "body checksum")
	_write(damaged, source.replace(envelope.rules_digest, "0".repeat(64)))
	_check(Codec.read(damaged).get("error") == "replay_rules_mismatch", "rules and inputs digest")
	_write(damaged, source + "\n")
	_check(Codec.read(damaged).get("error") == "replay_noncanonical_json", "noncanonical bytes rejected")
	_write(damaged, '{"version":1,' + source.substr(1))
	_check(Codec.read(damaged).get("error") == "replay_noncanonical_json", "duplicate field rejected")

	var viewer := Viewer.instantiate()
	root.add_child(viewer)
	var fake := Playback.new()
	var initial := {"tick":0, "clock_ms":0, "projection":{"hz":10},
		"events":[{"tick":0,"kind":"spawn"}]}
	_check(viewer.attach_playback(fake, initial).ok, "read-only session attached")
	_check(viewer._clock.text == "Replay | Tick 0 | 0.0 s" and viewer._events.text.contains("spawn"), "initial frame visible")
	viewer.step_replay()
	viewer.step_replay()
	_check(fake.steps == 1 and viewer._finished and viewer._step.disabled, "terminal replay cannot advance again")
	_check(viewer._result.text.contains("withdrawal_conditions_met") and viewer._result.text.contains(ID + "/settlement"),
		"final reason and ID shown")
	_check(viewer._events.text == "0  spawn\n1  operation_settled", "event order visible")
	var exits := [0]
	viewer.exit_requested.connect(func(): exits[0] += 1)
	viewer._leave()
	await process_frame
	_check(fake.closed == 1 and exits[0] == 1, "exit closes private replay once")
	await _real_replay(folder)
	print("FIRST_OPERATION_REPLAY_VIEWER %d/%d" % [_checks - _failures, _checks])
	quit(0 if _failures == 0 else 1)


func _real_replay(folder: String) -> void:
	var created := Adapter.prepare_fresh(REQUEST)
	if not created.ok:
		_check(false, "real owner preparation")
		return
	var owner: RefCounted = created.owner
	owner.publish()
	var records: Array = []
	for kind in ["withdraw", "finalize_withdrawal"]:
		var queued := Adapter.queue(owner, {"side":0,"kind":kind})
		if not queued.ok:
			_check(false, "real command")
			owner.close()
			return
		records.append(queued.record)
		Adapter.advance(owner)
	var terminal: Dictionary = owner.summary().summary.settlement
	owner.close()
	var record := Adapter.make_recording(REQUEST, created.operation_id, records, terminal)
	_check(record.ok, "terminal record generated by common adapter")
	if not record.ok:
		return
	var path := folder.path_join("real.pcopreplay")
	_check(Codec.write(record.bundle, path).ok, "real file published")
	var viewer := Viewer.instantiate()
	root.add_child(viewer)
	var opened: Dictionary = viewer.open_file(path)
	_check(opened.ok and opened.pending and viewer._frame.is_empty(), "no frame before terminal preflight")
	for i in 8:
		await process_frame
	_check(not viewer._frame.is_empty() and viewer._frame.tick == 0, "validated record starts at tick zero")
	for i in terminal.tick:
		viewer.step_replay()
	_check(viewer._finished and viewer._result.text.contains(terminal.id)
		and viewer._result.text.contains(terminal.reason), "real terminal identity and reason")
	viewer._leave()
	await process_frame

	var forged: Dictionary = record.bundle.duplicate(true)
	forged.expected_settlement.reason = "wrong_reason"
	var bad_path := folder.path_join("wrong-witness.pcopreplay")
	_check(Codec.write(forged, bad_path).ok, "structurally valid wrong witness fixture")
	var bad := Viewer.instantiate()
	root.add_child(bad)
	_check(bad.open_file(bad_path).ok, "wrong witness enters private verification")
	for i in 8:
		await process_frame
	_check(bad._frame.is_empty() and bad._result.text == "replay_settlement_mismatch",
		"wrong terminal witness cannot publish")
	bad._leave()
	await process_frame


func _write(path: String, content: String) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(content)
	file.close()


func _check(ok: bool, message: String) -> void:
	_checks += 1
	if not ok:
		_failures += 1
		printerr("REPLAY_FAIL ", message)

